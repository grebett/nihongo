---
interface Props {
  title: string;
  sakura?: boolean;
}

const { title, sakura = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>{title} - Nihongo</title>
    <!-- Prevent flash: apply saved theme before paint -->
    <script is:inline>
      (function() {
        const saved = localStorage.getItem('nihon-theme');
        if (saved) document.documentElement.setAttribute('data-theme', saved);
      })();
    </script>
  </head>
  <body>
    {sakura && <div class="sakura-container" id="sakura" aria-hidden="true"></div>}

    <nav>
      <a href={import.meta.env.BASE_URL} class="logo">
        <span class="logo-kanji">日本語</span>
        <span class="logo-text">Nihongo</span>
      </a>
      <button class="theme-toggle" id="theme-toggle" aria-label="Toggle dark mode">
        <svg class="theme-icon sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <svg class="theme-icon moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
    </nav>
    <main>
      <slot />
    </main>

    <footer>
      <div class="footer-wave"></div>
      <p>日本語 Nihongo</p>
    </footer>

    <style is:global>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      :root {
        /* Solarized palette constants */
        --base03:  #002b36;
        --base02:  #073642;
        --base01:  #586e75;
        --base00:  #657b83;
        --base0:   #839496;
        --base1:   #93a1a1;
        --base2:   #eee8d5;
        --base3:   #fdf6e3;

        --sol-red:     #dc322f;
        --sol-orange:  #cb4b16;
        --sol-yellow:  #b58900;
        --sol-green:   #859900;
        --sol-cyan:    #2aa198;
        --sol-blue:    #268bd2;
        --sol-violet:  #6c71c4;
        --sol-magenta: #d33682;

        /* Light mode (default) */
        --bg: var(--base3);
        --bg-elevated: var(--base2);
        --bg-card: #ffffff;
        --bg-input: var(--base3);
        --accent: var(--sol-red);
        --accent-hover: #c62828;
        --accent-glow: rgba(220, 50, 47, 0.1);
        --gold: var(--sol-yellow);
        --text: var(--base02);
        --text-muted: var(--base00);
        --success: var(--sol-cyan);
        --error: var(--sol-red);
        --border: #d6ceb5;
        --border-hover: var(--base1);
        --card-shadow: rgba(0, 0, 0, 0.04);
        --card-shadow-hover: rgba(220, 50, 47, 0.08);
        --wave-opacity: 0.03;
        --selection-bg: rgba(220, 50, 47, 0.15);
        --sakura-shadow: rgba(244, 167, 185, 0.4);
      }

      :root[data-theme="dark"] {
        --bg: var(--base03);
        --bg-elevated: var(--base02);
        --bg-card: #0a3340;
        --bg-input: var(--base02);
        --accent: var(--sol-red);
        --accent-hover: #e04848;
        --accent-glow: rgba(220, 50, 47, 0.15);
        --gold: var(--sol-yellow);
        --text: var(--base1);
        --text-muted: var(--base0);
        --success: var(--sol-cyan);
        --error: var(--sol-red);
        --border: #0e4452;
        --border-hover: var(--base01);
        --card-shadow: rgba(0, 0, 0, 0.15);
        --card-shadow-hover: rgba(220, 50, 47, 0.12);
        --wave-opacity: 0.02;
        --selection-bg: rgba(220, 50, 47, 0.25);
        --sakura-shadow: rgba(244, 167, 185, 0.3);
      }

      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        background: var(--bg);
        color: var(--text);
        min-height: 100vh;
        line-height: 1.6;
        overflow-x: hidden;
        position: relative;
      }

      /* Subtle warm ambient gradients */
      body::before {
        content: '';
        position: fixed;
        inset: 0;
        background-image:
          radial-gradient(ellipse at 15% 40%, rgba(220, 50, 47, 0.03) 0%, transparent 50%),
          radial-gradient(ellipse at 80% 15%, rgba(244, 167, 185, 0.03) 0%, transparent 50%),
          radial-gradient(ellipse at 55% 85%, rgba(181, 137, 0, 0.02) 0%, transparent 50%);
        pointer-events: none;
        z-index: 0;
      }

      /* Seigaiha (wave) pattern overlay */
      body::after {
        content: '';
        position: fixed;
        inset: 0;
        opacity: var(--wave-opacity);
        background-image: url("data:image/svg+xml,%3Csvg width='80' height='80' viewBox='0 0 80 80' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' stroke='%23073642' stroke-width='1'%3E%3Cpath d='M0 40c0-22.09 17.91-40 40-40s40 17.91 40 40'/%3E%3Cpath d='M0 40c0-15.46 12.54-28 28-28s28 12.54 28 28'/%3E%3Cpath d='M0 40c0-8.84 7.16-16 16-16s16 7.16 16 16'/%3E%3C/g%3E%3C/svg%3E");
        pointer-events: none;
        z-index: 0;
      }

      :root[data-theme="dark"] body::after {
        background-image: url("data:image/svg+xml,%3Csvg width='80' height='80' viewBox='0 0 80 80' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' stroke='%2393a1a1' stroke-width='1'%3E%3Cpath d='M0 40c0-22.09 17.91-40 40-40s40 17.91 40 40'/%3E%3Cpath d='M0 40c0-15.46 12.54-28 28-28s28 12.54 28 28'/%3E%3Cpath d='M0 40c0-8.84 7.16-16 16-16s16 7.16 16 16'/%3E%3C/g%3E%3C/svg%3E");
      }

      nav {
        position: sticky;
        top: 0;
        z-index: 100;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.8rem 2rem;
        border-bottom: 1px solid var(--border);
        background: var(--bg-card);
        backdrop-filter: blur(12px);
      }

      .logo {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        transition: opacity 0.2s;
      }
      .logo:hover { opacity: 0.75; }

      .logo-kanji {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--accent);
        letter-spacing: 0.05em;
      }

      .logo-text {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--text-muted);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      /* Theme toggle */
      .theme-toggle {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        background: none;
        border: 1px solid var(--border);
        border-radius: 8px;
        color: var(--text-muted);
        cursor: pointer;
        transition: color 0.2s, border-color 0.2s;
      }
      .theme-toggle:hover {
        color: var(--accent);
        border-color: var(--accent);
      }

      /* Light mode: show moon, hide sun */
      .theme-icon.sun { display: none; }
      .theme-icon.moon { display: block; }

      /* Dark mode: show sun, hide moon */
      :root[data-theme="dark"] .theme-icon.sun { display: block; }
      :root[data-theme="dark"] .theme-icon.moon { display: none; }

      main {
        position: relative;
        z-index: 1;
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem;
      }

      footer {
        position: relative;
        z-index: 1;
        text-align: center;
        padding: 2rem;
        margin-top: 3rem;
        color: var(--text-muted);
        font-size: 0.75rem;
        letter-spacing: 0.15em;
        opacity: 0.4;
      }
      .footer-wave {
        width: 60px;
        height: 1px;
        background: var(--border);
        margin: 0 auto 1rem;
      }

      /* Sakura petals */
      .sakura-container {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        overflow: hidden;
      }

      .sakura-petal {
        position: absolute;
        top: -20px;
        pointer-events: none;
        will-change: transform;
        animation: sakura-fall linear forwards;
      }

      .sakura-petal svg {
        filter: drop-shadow(0 0 3px var(--sakura-shadow));
      }

      @keyframes sakura-fall {
        0% {
          opacity: 0;
          transform: translateX(0) translateY(0) rotate(0deg) scale(1);
        }
        5% {
          opacity: 1;
        }
        85% {
          opacity: 1;
        }
        100% {
          opacity: 0;
          transform: translateX(var(--drift)) translateY(calc(100vh + 40px)) rotate(var(--spin)) scale(0.8);
        }
      }

      /* Furigana */
      ruby { ruby-align: center; }
      ruby rt {
        font-size: 0.55em;
        font-weight: 400;
        color: var(--text-muted);
      }

      /* Scrollbar */
      ::-webkit-scrollbar { width: 6px; }
      ::-webkit-scrollbar-track { background: var(--bg); }
      ::-webkit-scrollbar-thumb {
        background: var(--border);
        border-radius: 3px;
      }
      ::-webkit-scrollbar-thumb:hover { background: var(--border-hover); }

      /* Selection */
      ::selection {
        background: var(--selection-bg);
        color: var(--text);
      }
    </style>

    <script>
      // Theme toggle
      const toggle = document.getElementById('theme-toggle')!;
      toggle.addEventListener('click', () => {
        const html = document.documentElement;
        const current = html.getAttribute('data-theme');
        const next = current === 'dark' ? 'light' : 'dark';
        html.setAttribute('data-theme', next);
        localStorage.setItem('nihon-theme', next);
      });
    </script>

    {sakura && (
      <script>
        function createSakura() {
          const container = document.getElementById('sakura');
          if (!container) return;

          const petalSVGs = [
            `<svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M9 1c.8 2.5 2.5 4 5 4-1.5 1.8-1.5 3.8 0 6-2.5 0-4.2 1.5-5 4-.8-2.5-2.5-4-5-4 1.5-2.2 1.5-4.2 0-6 2.5 0 4.2-1.5 5-4z" fill="currentColor"/></svg>`,
            `<svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M7 0C8.5 3 10 5.5 7 9C4 5.5 5.5 3 7 0z" fill="currentColor"/></svg>`,
            `<svg width="10" height="10" viewBox="0 0 10 10" fill="none"><ellipse cx="5" cy="5" rx="4" ry="5" fill="currentColor"/></svg>`,
          ];

          const colors = [
            'rgba(244, 167, 185, 0.55)',
            'rgba(252, 180, 200, 0.45)',
            'rgba(211, 54, 130, 0.25)',
            'rgba(220, 50, 47, 0.2)',
          ];

          function spawnPetal() {
            const petal = document.createElement('div');
            petal.classList.add('sakura-petal');

            const svgIdx = Math.floor(Math.random() * petalSVGs.length);
            petal.innerHTML = petalSVGs[svgIdx];
            petal.style.color = colors[Math.floor(Math.random() * colors.length)];

            const left = Math.random() * 100;
            const size = 0.5 + Math.random() * 1;
            const duration = 10 + Math.random() * 15;
            const drift = -60 + Math.random() * 120;
            const spin = 180 + Math.random() * 540;
            const delay = Math.random() * 2;

            petal.style.left = `${left}%`;
            petal.style.setProperty('--drift', `${drift}px`);
            petal.style.setProperty('--spin', `${spin}deg`);
            petal.style.transform = `scale(${size})`;
            petal.style.animationDuration = `${duration}s`;
            petal.style.animationDelay = `${delay}s`;

            container.appendChild(petal);

            setTimeout(() => {
              petal.remove();
            }, (duration + delay) * 1000 + 500);
          }

          for (let i = 0; i < 8; i++) {
            setTimeout(spawnPetal, i * 600);
          }

          setInterval(spawnPetal, 2500 + Math.random() * 2000);
        }

        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          createSakura();
        }
      </script>
    )}
  </body>
</html>
