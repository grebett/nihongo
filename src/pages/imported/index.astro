---
import Layout from '../../layouts/Layout.astro';
import '../../styles/quiz.css';
---

<Layout title="Imported lessons">
  <a href={import.meta.env.BASE_URL} class="back">&larr; Home</a>

  <!-- View: import (default) -->
  <div id="view-import" class="view hidden">
    <header class="section-header">
      <h1>Imported lessons</h1>
      <p class="description">Import a lesson in YAML bundle format (see <code>docs/LLM_PROMPT.md</code>).</p>
    </header>

    <section class="import-section">
      <div class="import-controls">
        <label for="file-input" class="file-label">Choose a .yaml / .yml / .txt file</label>
        <input id="file-input" type="file" accept=".yaml,.yml,.txt,.json" />
      </div>
      <textarea id="paste-area" rows="14" placeholder="…or paste the YAML content here"></textarea>
      <div class="import-actions">
        <button id="import-btn" class="submit-btn">Import</button>
      </div>
      <div id="import-error" class="import-error hidden"></div>
      <div id="import-success" class="import-success hidden"></div>
    </section>

    <section class="imports-list-section">
      <h2>Currently imported lessons</h2>
      <div id="imports-list"></div>
    </section>
  </div>

  <!-- View: lesson outline -->
  <div id="view-lesson" class="view hidden">
    <header class="lesson-header">
      <h1 id="lesson-title"></h1>
      <p id="lesson-description" class="description"></p>
      <p id="lesson-source" class="source"></p>
    </header>
    <div id="sections-grid" class="sections-grid"></div>
  </div>

  <!-- View: section quiz -->
  <div id="view-section" class="view hidden">
    <a id="lesson-back" href="#" class="back">&larr; <span id="lesson-back-title"></span></a>
    <header class="section-header">
      <span id="section-number" class="section-number"></span>
      <h1 id="section-title"></h1>
      <p id="section-description" class="description"></p>
    </header>
    <div id="tabs-container"></div>
    <div id="panels-container"></div>
  </div>
</Layout>

<style is:global>
  .view.hidden { display: none; }
  .view { display: block; }

  .import-section {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.4rem;
    margin-bottom: 2.2rem;
    box-shadow: var(--shadow-sm);
  }
  .import-controls {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  .file-label {
    padding: 0.55rem 1rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 9px;
    color: var(--text);
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--dur-fast) var(--ease);
  }
  .file-label:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-soft);
  }
  #file-input { display: none; }

  #paste-area {
    width: 100%;
    background: var(--bg-input);
    border: 1px solid var(--border);
    border-radius: 9px;
    color: var(--text);
    font-family: ui-monospace, 'SF Mono', Menlo, Monaco, monospace;
    font-size: 0.82rem;
    line-height: 1.55;
    padding: 0.85rem;
    resize: vertical;
    outline: none;
    transition: border-color var(--dur-fast) var(--ease),
                box-shadow var(--dur-fast) var(--ease);
  }
  #paste-area:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .import-actions { margin-top: 0.85rem; }

  .import-error,
  .import-success {
    margin-top: 0.85rem;
    padding: 0.75rem 1rem;
    border-radius: 9px;
    font-size: 0.88rem;
    font-weight: 500;
    line-height: 1.5;
  }
  .import-error {
    background: var(--accent-soft);
    border: 1px solid var(--error);
    color: var(--error);
    white-space: pre-wrap;
  }
  .import-success {
    background: rgba(31, 122, 106, 0.10);
    border: 1px solid var(--success);
    color: var(--success);
    font-weight: 600;
  }

  .imports-list-section h2 {
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    margin-bottom: 0.9rem;
    color: var(--text-strong);
  }

  .import-card-row {
    display: flex;
    gap: 0.55rem;
    align-items: stretch;
    margin-bottom: 0.55rem;
  }
  .import-card-row > .import-card {
    flex: 1;
    margin: 0;
  }
  .import-card-row > .icon-btn {
    width: 42px;
    height: auto;
  }
  .import-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.95rem 1.1rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    text-decoration: none;
    color: var(--text);
    box-shadow: var(--shadow-sm);
    transition: border-color var(--dur) var(--ease),
                box-shadow var(--dur) var(--ease),
                transform var(--dur) var(--ease);
  }
  .import-card:hover {
    border-color: var(--border-hover);
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
  }
  .import-card-info { flex: 1; min-width: 0; }
  .import-card-info h3 {
    font-size: 0.98rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
    color: var(--text-strong);
    letter-spacing: -0.005em;
  }

  .imports-empty {
    color: var(--text-muted);
    font-size: 0.88rem;
    font-style: italic;
  }

  /* Lesson outline view (mirrors built-in /lesson/[id]/index.astro styling) */
  .lesson-header { margin-bottom: 2.2rem; }
  .lesson-header h1 {
    font-size: 1.65rem;
    margin-bottom: 0.45rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--text-strong);
  }
  .source {
    color: var(--text-subtle);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .sections-grid {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .section-card {
    display: flex;
    align-items: flex-start;
    gap: 1.1rem;
    padding: 1.1rem 1.3rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    text-decoration: none;
    color: var(--text);
    box-shadow: var(--shadow-sm);
    transition: border-color var(--dur) var(--ease),
                box-shadow var(--dur) var(--ease),
                transform var(--dur) var(--ease);
  }
  .section-card:hover {
    border-color: var(--border-hover);
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
  }
  .section-card .section-number {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
    width: 1.8rem;
    padding-top: 0.15rem;
    opacity: 0.85;
    letter-spacing: -0.02em;
  }
  .section-info { flex: 1; }
  .section-info h2 {
    font-size: 1.02rem;
    margin-bottom: 0.3rem;
    font-weight: 700;
    color: var(--text-strong);
    letter-spacing: -0.005em;
  }
  .section-info p {
    color: var(--text-muted);
    font-size: 0.85rem;
    margin-bottom: 0.5rem;
    line-height: 1.55;
  }
</style>

<script>
  import yaml from 'js-yaml';
  import {
    getAllImported,
    getImported,
    saveImported,
    deleteImported,
    parseImportYaml,
  } from '../../scripts/imported-lessons';
  import { renderQuestionCard } from '../../scripts/quiz-render';
  import { setupQuiz } from '../../scripts/quiz';
  import { icon } from '../../scripts/icons';
  import type { Question, Lesson } from '../../scripts/lessons';

  const BASE = (import.meta.env.BASE_URL || '').replace(/\/$/, '');

  function escapeText(s: string): string {
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function showView(name: 'import' | 'lesson' | 'section') {
    for (const v of ['import', 'lesson', 'section']) {
      const el = document.getElementById(`view-${v}`);
      if (el) el.classList.toggle('hidden', v !== name);
    }
  }

  function renderImportsList() {
    const container = document.getElementById('imports-list')!;
    const all = getAllImported();
    if (all.length === 0) {
      container.innerHTML = '<p class="imports-empty">No imported lessons yet.</p>';
      return;
    }
    container.innerHTML = all
      .map(({ lesson }) => {
        const sectionsCount = lesson.sections.length;
        const sectionsLabel = sectionsCount === 1 ? 'section' : 'sections';
        return `<div class="import-card-row">
          <a class="import-card" href="${BASE}/imported/?lesson=${encodeURIComponent(lesson.id)}">
            <div class="import-card-info">
              <h3>${escapeText(lesson.title)}</h3>
              <div class="meta-row">
                ${lesson.source ? `<span class="meta-item meta-source">${escapeText(lesson.source)}</span>` : ''}
                <span class="meta-item">${icon('layers', 13)} ${sectionsCount} ${sectionsLabel}</span>
              </div>
            </div>
            <span class="card-chevron" aria-hidden="true">${icon('chevron-right', 18)}</span>
          </a>
          <button class="icon-btn danger" data-delete-id="${escapeText(lesson.id)}" aria-label="Delete">${icon('trash', 16)}</button>
        </div>`;
      })
      .join('');

    container.querySelectorAll('[data-delete-id]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = (btn as HTMLElement).dataset.deleteId!;
        if (!confirm(`Delete imported lesson "${id}"?`)) return;
        deleteImported(id);
        renderImportsList();
      });
    });
  }

  function attemptImport(text: string) {
    const errEl = document.getElementById('import-error')!;
    const okEl = document.getElementById('import-success')!;
    errEl.classList.add('hidden');
    okEl.classList.add('hidden');

    const result = parseImportYaml(text);
    if (!result.ok) {
      errEl.textContent = result.error;
      errEl.classList.remove('hidden');
      return;
    }
    saveImported(result.bundle);
    okEl.textContent = `Lesson "${result.bundle.lesson.title}" imported!`;
    okEl.classList.remove('hidden');
    (document.getElementById('paste-area') as HTMLTextAreaElement).value = '';
    renderImportsList();
  }

  function initImportView() {
    document.getElementById('import-btn')!.addEventListener('click', () => {
      const text = (document.getElementById('paste-area') as HTMLTextAreaElement).value.trim();
      if (!text) {
        const errEl = document.getElementById('import-error')!;
        errEl.textContent = 'The field is empty.';
        errEl.classList.remove('hidden');
        return;
      }
      attemptImport(text);
    });

    const fileInput = document.getElementById('file-input') as HTMLInputElement;
    fileInput.addEventListener('change', async () => {
      const file = fileInput.files?.[0];
      if (!file) return;
      const text = await file.text();
      (document.getElementById('paste-area') as HTMLTextAreaElement).value = text;
      attemptImport(text);
      fileInput.value = '';
    });

    renderImportsList();
  }

  function renderLessonView(lessonId: string) {
    const bundle = getImported(lessonId);
    if (!bundle) {
      document.getElementById('lesson-title')!.textContent = 'Lesson not found';
      document.getElementById('lesson-description')!.textContent = `No imported lesson with id "${lessonId}".`;
      return;
    }
    const { lesson, questions } = bundle;
    document.title = `${lesson.title} - Nihongo`;
    document.getElementById('lesson-title')!.textContent = lesson.title;
    document.getElementById('lesson-description')!.textContent = lesson.description;
    document.getElementById('lesson-source')!.textContent = lesson.source ? `Source: ${lesson.source}` : '';

    const grid = document.getElementById('sections-grid')!;
    grid.innerHTML = lesson.sections
      .map((sec, i) => {
        const qCount = sec.parts.reduce((sum, p) => sum + (questions[p.id]?.length ?? 0), 0);
        const partsLabel = sec.parts.length === 1 ? 'part' : 'parts';
        const qLabel = qCount === 1 ? 'question' : 'questions';
        return `<a href="${BASE}/imported/?lesson=${encodeURIComponent(lesson.id)}&section=${encodeURIComponent(sec.id)}" class="section-card">
          <span class="section-number">${String(i + 1).padStart(2, '0')}</span>
          <div class="section-info">
            <h2>${escapeText(sec.title)}</h2>
            <p>${escapeText(sec.description ?? '')}</p>
            <div class="meta-row">
              <span class="meta-item">${icon('layers', 13)} ${sec.parts.length} ${partsLabel}</span>
              <span class="meta-item">${icon('list', 13)} ${qCount} ${qLabel}</span>
            </div>
          </div>
          <span class="card-chevron" aria-hidden="true">${icon('chevron-right', 18)}</span>
        </a>`;
      })
      .join('');
  }

  function renderSectionView(lessonId: string, sectionId: string) {
    const bundle = getImported(lessonId);
    if (!bundle) {
      document.getElementById('section-title')!.textContent = 'Lesson not found';
      return;
    }
    const { lesson, questions } = bundle;
    const section = lesson.sections.find((s) => s.id === sectionId);
    if (!section) {
      document.getElementById('section-title')!.textContent = 'Section not found';
      return;
    }
    document.title = `${section.title} - ${lesson.title}`;

    const back = document.getElementById('lesson-back') as HTMLAnchorElement;
    back.href = `${BASE}/imported/?lesson=${encodeURIComponent(lesson.id)}`;
    document.getElementById('lesson-back-title')!.textContent = lesson.title;

    const sectionIdx = lesson.sections.indexOf(section);
    document.getElementById('section-number')!.textContent = `Section ${sectionIdx + 1} of ${lesson.sections.length}`;
    document.getElementById('section-title')!.textContent = section.title;
    document.getElementById('section-description')!.textContent = section.description ?? '';

    const tabsContainer = document.getElementById('tabs-container')!;
    const panelsContainer = document.getElementById('panels-container')!;

    if (section.parts.length > 1) {
      tabsContainer.innerHTML = `<div class="tabs" role="tablist">
        ${section.parts
          .map(
            (p, i) =>
              `<button class="tab ${i === 0 ? 'active' : ''}" role="tab" data-tab="${escapeText(p.id)}" aria-selected="${i === 0 ? 'true' : 'false'}">${escapeText(p.title)}</button>`,
          )
          .join('')}
      </div>`;
    }

    panelsContainer.innerHTML = section.parts
      .map((part, i) => {
        const partQuestions: Question[] = questions[part.id] ?? [];
        if (partQuestions.length === 0) {
          return `<div class="tab-panel ${i === 0 ? 'active' : ''}" data-panel="${escapeText(part.id)}" role="tabpanel">
            <p class="description">No questions for this part.</p>
          </div>`;
        }
        const cards = partQuestions.map((q, qi) => renderQuestionCard(q, qi)).join('');
        return `<div class="tab-panel ${i === 0 ? 'active' : ''}" data-panel="${escapeText(part.id)}" role="tabpanel">
          <div class="quiz-section" data-part-id="${escapeText(part.id)}" data-lesson-id="${escapeText(lesson.id)}">
            <div class="quiz-header">
              <h2>Practice</h2>
              <div class="quiz-controls">
                <button class="hard-mode-toggle" title="Show all questions">${icon('flame', 13)}Hard</button>
                <div class="score" data-score="${escapeText(part.id)}">0 / ${partQuestions.length}</div>
              </div>
            </div>
            <div class="questions-list">${cards}</div>
            <button class="reset-btn">Reset</button>
            <div class="results-summary hidden"></div>
          </div>
        </div>`;
      })
      .join('');

    // Wire tab switching (no video, simpler than initTabsAndVideo)
    document.querySelectorAll('#tabs-container .tab').forEach((tab) => {
      tab.addEventListener('click', () => {
        const targetId = (tab as HTMLElement).dataset.tab;
        document.querySelectorAll('#tabs-container .tab').forEach((t) => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');
        document.querySelectorAll('#panels-container .tab-panel').forEach((panel) => {
          (panel as HTMLElement).classList.toggle(
            'active',
            (panel as HTMLElement).dataset.panel === targetId,
          );
        });
      });
    });

    // Initialize quiz logic per panel
    document.querySelectorAll('#panels-container .tab-panel').forEach(setupQuiz);
  }

  // Bootstrap: pick view by query params
  const params = new URLSearchParams(window.location.search);
  const lessonParam = params.get('lesson');
  const sectionParam = params.get('section');

  if (lessonParam && sectionParam) {
    showView('section');
    renderSectionView(lessonParam, sectionParam);
  } else if (lessonParam) {
    showView('lesson');
    renderLessonView(lessonParam);
  } else {
    showView('import');
    initImportView();
  }
</script>
