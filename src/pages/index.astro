---
import Layout from '../layouts/Layout.astro';
import { getAllLessons } from '../scripts/lessons';

const lessons = getAllLessons();
---

<Layout title="Home" sakura>
  <h1>Lessons</h1>
  <div class="lessons">
    {lessons.map((lesson) => (
      <a href={`${import.meta.env.BASE_URL}/lesson/${lesson.id}`} class="lesson-card">
        <div class="thumb-wrap">
          {lesson.coverImage ? (
            <img
              src={`${import.meta.env.BASE_URL}/${lesson.coverImage}`}
              alt={lesson.title}
              class="thumbnail"
            />
          ) : lesson.videoId ? (
            <img
              src={`https://i.ytimg.com/vi/${lesson.videoId}/mqdefault.jpg`}
              alt={lesson.title}
              class="thumbnail"
            />
          ) : (
            <div class="thumbnail thumbnail-placeholder" aria-hidden="true">
              <span>{lesson.title.charAt(0)}</span>
            </div>
          )}
          {lesson.number !== undefined && lesson.number !== '' && (
            <svg class="lesson-badge" viewBox="0 0 40 40" aria-hidden="true">
              <path class="leaf-body" d="M 36 8 Q 37 36 9 31 Q 8 4 36 8 Z" />
              <path class="leaf-stem" d="M 9 31 Q 6 34 4 37" />
              <path class="leaf-vein" d="M 12 30 Q 19 22 32 11" />
              <text x="22" y="21" text-anchor="middle" dominant-baseline="central">{lesson.number}</text>
            </svg>
          )}
        </div>
        <div class="lesson-info">
          <h2>{lesson.title}</h2>
          <p>{lesson.description}</p>
          <div class="meta-row">
            <span class="meta-item meta-source">{lesson.source}</span>
            <span class="meta-item">
              <svg class="icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
              {lesson.sections.length} {lesson.sections.length === 1 ? 'section' : 'sections'}
            </span>
          </div>
        </div>
        <span class="card-chevron" aria-hidden="true">
          <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </span>
      </a>
    ))}
  </div>

  <section class="imported-section">
    <div class="imported-header">
      <h2>Imported lessons</h2>
      <a href={`${import.meta.env.BASE_URL}/imported/`} class="import-btn">
        <svg class="icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Import a lesson
      </a>
    </div>
    <div id="imported-list" class="lessons"></div>
  </section>

  <style is:global>
    h1 {
      font-size: 1.85rem;
      margin-bottom: 1.6rem;
      font-weight: 800;
      letter-spacing: -0.025em;
      color: var(--text-strong);
    }

    .lessons { display: flex; flex-direction: column; gap: 0.85rem; }

    .lesson-card {
      display: flex;
      gap: 1.3rem;
      padding: 1.1rem;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 14px;
      text-decoration: none;
      color: var(--text);
      box-shadow: var(--shadow-sm);
      transition: border-color var(--dur) var(--ease),
                  box-shadow var(--dur) var(--ease),
                  transform var(--dur) var(--ease);
    }
    .lesson-card:hover {
      border-color: var(--border-hover);
      box-shadow: var(--shadow-lg);
      transform: translateY(-2px);
    }

    .thumb-wrap {
      position: relative;
      flex-shrink: 0;
      width: 200px;
      height: 112px;
    }
    .thumbnail {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 8px;
      display: block;
      box-shadow: inset 0 0 0 1px var(--border);
    }
    .thumbnail-placeholder {
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, var(--bg-elevated), var(--bg-muted));
      color: var(--text-subtle);
      font-size: 2.6rem;
      font-weight: 800;
      letter-spacing: -0.04em;
      font-family: 'Noto Sans JP', sans-serif;
    }
    .lesson-badge {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 68px;
      height: 68px;
      filter: contrast(0.82) saturate(0.85) drop-shadow(6px 6px 0px rgba(0, 0, 0, 0.33));
    }
    .lesson-badge .leaf-body {
      fill: var(--bg-card);
      stroke: var(--success);
      stroke-width: 1.25;
      stroke-linejoin: round;
    }
    .lesson-badge .leaf-stem,
    .lesson-badge .leaf-vein {
      fill: none;
      stroke: var(--success);
      stroke-width: 1;
      stroke-linecap: round;
      opacity: 0.6;
    }
    .lesson-badge text {
      fill: var(--success);
      font-family: 'Inter', sans-serif;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: -0.02em;
      paint-order: stroke fill;
      stroke: var(--bg-card);
      stroke-width: 3;
    }

    .lesson-info {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-width: 0;
    }
    .lesson-info h2 {
      font-size: 1.1rem;
      margin-bottom: 0.35rem;
      font-weight: 700;
      letter-spacing: -0.01em;
      color: var(--text-strong);
    }
    .lesson-info p {
      color: var(--text-muted);
      font-size: 0.88rem;
      margin-bottom: 0.55rem;
      line-height: 1.5;
    }

    @media (max-width: 600px) {
      .lesson-card { flex-direction: column; }
      .thumb-wrap { width: 100%; height: auto; aspect-ratio: 16/9; }
    }

    .imported-section {
      margin-top: 3rem;
      padding-top: 1.6rem;
      border-top: 1px solid var(--border);
    }
    .imported-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.1rem;
    }
    .imported-header h2 {
      font-size: 1.15rem;
      font-weight: 800;
      letter-spacing: -0.01em;
      color: var(--text-strong);
      margin: 0;
    }
    .import-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.5rem 0.95rem 0.5rem 0.8rem;
      background: transparent;
      border: 1px solid var(--accent);
      border-radius: 9px;
      color: var(--accent);
      font-size: 0.82rem;
      font-weight: 600;
      letter-spacing: 0.01em;
      text-decoration: none;
      transition: background var(--dur-fast) var(--ease),
                  color var(--dur-fast) var(--ease),
                  box-shadow var(--dur-fast) var(--ease);
    }
    .import-btn:hover {
      background: var(--accent);
      color: white;
      box-shadow: var(--shadow-accent);
    }
    .imported-empty {
      color: var(--text-muted);
      font-size: 0.88rem;
      font-style: italic;
      padding: 0.8rem 0;
    }
    .lesson-card-row {
      display: flex;
      gap: 0.55rem;
      align-items: stretch;
    }
    /* Delete button stretches to match card height */
    .lesson-card-row > .icon-btn {
      width: 42px;
      height: auto;
    }
  </style>
</Layout>

<script>
  import { getAllImported, deleteImported } from '../scripts/imported-lessons';
  import { icon } from '../scripts/icons';

  const BASE = (import.meta.env.BASE_URL || '').replace(/\/$/, '');

  function escapeText(s: string): string {
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function escapeAttr(s: string): string {
    return String(s).replace(/&/g, '&amp;').replace(/"/g, '&quot;');
  }

  function isExternalImage(s: string | undefined): boolean {
    return !!s && /^(https?:|data:)/.test(s);
  }

  function thumbnailHtml(lesson: { title: string; coverImage?: string; videoId?: string }): string {
    const initial = escapeText(lesson.title.charAt(0));
    if (isExternalImage(lesson.coverImage)) {
      return `<img src="${escapeAttr(lesson.coverImage!)}" alt="${escapeAttr(lesson.title)}" class="thumbnail" loading="lazy">`;
    }
    if (lesson.videoId) {
      return `<img src="https://i.ytimg.com/vi/${escapeAttr(lesson.videoId)}/mqdefault.jpg" alt="${escapeAttr(lesson.title)}" class="thumbnail" loading="lazy">`;
    }
    return `<div class="thumbnail thumbnail-placeholder" aria-hidden="true"><span>${initial}</span></div>`;
  }

  function renderImported() {
    const container = document.getElementById('imported-list')!;
    const all = getAllImported();
    if (all.length === 0) {
      container.innerHTML = '<p class="imported-empty">No imported lessons yet. Click "Import a lesson" to get started.</p>';
      return;
    }
    container.innerHTML = all
      .map(({ lesson }) => {
        const badge = lesson.number !== undefined && lesson.number !== ''
          ? `<svg class="lesson-badge" viewBox="0 0 40 40" aria-hidden="true">
              <path class="leaf-body" d="M 36 8 Q 37 36 9 31 Q 8 4 36 8 Z"/>
              <path class="leaf-stem" d="M 9 31 Q 6 34 4 37"/>
              <path class="leaf-vein" d="M 12 30 Q 19 22 32 11"/>
              <text x="22" y="21" text-anchor="middle" dominant-baseline="central">${escapeText(String(lesson.number))}</text>
            </svg>`
          : '';
        const sectionsLabel = lesson.sections.length === 1 ? 'section' : 'sections';
        return `<div class="lesson-card-row">
          <a class="lesson-card" href="${BASE}/imported/?lesson=${encodeURIComponent(lesson.id)}" style="flex:1;">
            <div class="thumb-wrap">
              ${thumbnailHtml(lesson)}
              ${badge}
            </div>
            <div class="lesson-info">
              <h2>${escapeText(lesson.title)}</h2>
              <p>${escapeText(lesson.description ?? '')}</p>
              <div class="meta-row">
                ${lesson.source ? `<span class="meta-item meta-source">${escapeText(lesson.source)}</span>` : ''}
                <span class="meta-item">${icon('layers', 13)} ${lesson.sections.length} ${sectionsLabel}</span>
              </div>
            </div>
            <span class="card-chevron" aria-hidden="true">${icon('chevron-right', 18)}</span>
          </a>
          <button class="icon-btn danger" data-delete-id="${escapeText(lesson.id)}" aria-label="Delete">${icon('trash', 16)}</button>
        </div>`;
      })
      .join('');

    container.querySelectorAll('[data-delete-id]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = (btn as HTMLElement).dataset.deleteId!;
        if (!confirm(`Delete imported lesson "${id}"?`)) return;
        deleteImported(id);
        renderImported();
      });
    });
  }

  renderImported();
</script>
