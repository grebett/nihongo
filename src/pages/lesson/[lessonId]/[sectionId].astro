---
import Layout from '../../../layouts/Layout.astro';
import { getAllLessons, getQuestions } from '../../../scripts/lessons';
import type { Question } from '../../../scripts/lessons';
import { getCardAnswer, getCardDisplay } from '../../../scripts/quiz-render';
import '../../../styles/quiz.css';

export function getStaticPaths() {
  const lessons = getAllLessons();
  return lessons.flatMap((lesson) => {
    const questions = getQuestions(lesson.id);
    return lesson.sections.map((section, idx) => ({
      params: { lessonId: lesson.id, sectionId: section.id },
      props: {
        lesson,
        section,
        questions,
        sectionIndex: idx,
        totalSections: lesson.sections.length,
        prevSection: idx > 0 ? lesson.sections[idx - 1] : null,
        nextSection: idx < lesson.sections.length - 1 ? lesson.sections[idx + 1] : null,
      },
    }));
  });
}

const { lesson, section, questions, sectionIndex, totalSections, prevSection, nextSection } = Astro.props;

const hasVideo = Boolean(lesson.videoId);
---

<Layout title={`${section.title} - ${lesson.title}`}>
  <a href={`${import.meta.env.BASE_URL}/lesson/${lesson.id}`} class="back">&larr; {lesson.title}</a>

  <header class="section-header">
    <span class="section-number">Section {sectionIndex + 1} / {totalSections}</span>
    <h1>{section.title}</h1>
    <p class="description">{section.description}</p>
  </header>

  <!-- Tabs -->
  {section.parts.length > 1 && (() => {
    const testKey = `${section.id}-test`;
    const testQuestions: Question[] = (questions[testKey] ?? []) as Question[];
    return (
      <div class="tabs" role="tablist">
        {section.parts.map((part, i) => (
          <button
            class={`tab ${i === 0 ? 'active' : ''}`}
            role="tab"
            data-tab={part.id}
            aria-selected={i === 0 ? 'true' : 'false'}
          >
            {part.title}
          </button>
        ))}
        {testQuestions.length > 0 && (
          <button class="tab tab-test" role="tab" data-tab="__test" aria-selected="false">
            Test
          </button>
        )}
      </div>
    );
  })()}

  <!-- Tab panels -->
  {section.parts.map((part, i) => {
    const partQuestions: Question[] = questions[part.id] ?? [];
    return (
      <div
        class={`tab-panel ${i === 0 ? 'active' : ''}`}
        data-panel={part.id}
        role="tabpanel"
      >
        {hasVideo && (
          <div class="video-area">
            <div class="video-container">
              <iframe
                class="video-player"
                data-video-id={lesson.videoId}
                data-start={part.startTime}
                data-end={part.endTime}
                src={i === 0
                  ? `https://www.youtube.com/embed/${lesson.videoId}?start=${part.startTime}&end=${part.endTime}`
                  : 'about:blank'}
                title={part.title}
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
            <button
              class="replay-btn"
              data-video-id={lesson.videoId}
              data-start={part.startTime}
              data-end={part.endTime}
            >
              Replay
            </button>
          </div>
        )}

        {partQuestions.length > 0 && (
          <div class="quiz-section" data-part-id={part.id} data-lesson-id={lesson.id}>
            <div class="quiz-header">
              <h2>Practice</h2>
              <div class="quiz-controls">
                <button class="hard-mode-toggle" title="Show all questions">Hard</button>
                <div class="score" data-score={part.id}>0 / {partQuestions.length}</div>
              </div>
            </div>

            <div class="questions-list">
              {partQuestions.map((q: Question, qi: number) => (
                <div class="question-card" data-type={q.type} data-answer={getCardAnswer(q)} data-display={getCardDisplay(q)}>
                  <div class="question-number">Q{qi + 1}</div>
                  <p class="question-text" set:html={q.question} />

                  {q.type === 'multiple-choice' && q.options && (
                    <div class="options">
                      {q.options.map((opt: string, j: number) => (
                        <button class="option-btn" data-option={j}><Fragment set:html={opt} /></button>
                      ))}
                    </div>
                  )}

                  {q.type === 'free-input' && (
                    <div class="input-group">
                      <input
                        type="text"
                        class="answer-input"
                        placeholder="Type your answer..."
                        autocomplete="off"
                      />
                      <button class="submit-btn">Check</button>
                    </div>
                  )}

                  {q.type === 'sentence-blocks' && q.blocks && (
                    <div class="blocks-area">
                      <div class="blocks-slots" data-slot-count={q.blocks.length}>
                        {q.blocks.map((_, si: number) => (
                          <div class="block-slot" data-slot-index={si}></div>
                        ))}
                      </div>
                      <div class="blocks-pool">
                        {[...q.blocks, ...(q.distractors ?? [])].map((b, bi: number) => (
                          <button class="block" data-correct-index={bi < (q.blocks?.length ?? 0) ? bi : -1}>
                            <Fragment set:html={b.text} />
                          </button>
                        ))}
                      </div>
                      <div class="blocks-actions">
                        <button class="check-blocks-btn">Check</button>
                        <button class="reset-blocks-btn" type="button">Reset blocks</button>
                      </div>
                    </div>
                  )}

                  {q.type === 'matching' && q.pairs && (
                    <div class="match-grid">
                      <div class="match-col" data-side="jp">
                        {q.pairs.map((p, pi: number) => (
                          <button class="match-item" data-pair-id={pi} data-side="jp">
                            <Fragment set:html={p.jp} />
                          </button>
                        ))}
                      </div>
                      <div class="match-col" data-side="meaning">
                        {q.pairs.map((p, pi: number) => (
                          <button class="match-item" data-pair-id={pi} data-side="meaning">
                            {p.meaning}
                          </button>
                        ))}
                      </div>
                    </div>
                  )}

                  <div class="hint">
                    <button class="hint-btn">Show hint</button>
                    <p class="hint-text hidden">{q.hint}</p>
                  </div>

                  <div class="feedback hidden"></div>
                </div>
              ))}
            </div>

            <button class="reset-btn">Reset</button>
            <div class="results-summary hidden"></div>
          </div>
        )}
      </div>
    );
  })}

  <!-- Test panel -->
  {section.parts.length > 1 && (() => {
    const testKey = `${section.id}-test`;
    const testQuestions: Question[] = (questions[testKey] ?? []) as Question[];
    if (testQuestions.length === 0) return null;
    return (
      <div class="tab-panel" data-panel="__test" role="tabpanel">
        <div class="quiz-section" data-part-id={`${section.id}-test`} data-lesson-id={lesson.id}>
          <div class="quiz-header">
            <h2>Test — All forms</h2>
            <div class="quiz-controls">
              <button class="hard-mode-toggle" title="Show all questions">Hard</button>
              <div class="score" data-score="__test">0 / {testQuestions.length}</div>
            </div>
          </div>

          <div class="questions-list" id="test-questions">
            {testQuestions.map((q: Question, qi: number) => (
              <div class="question-card" data-type={q.type} data-answer={getCardAnswer(q)} data-display={getCardDisplay(q)}>
                <div class="question-number">Q{qi + 1}</div>
                <p class="question-text" set:html={q.question} />

                {q.type === 'multiple-choice' && q.options && (
                  <div class="options">
                    {q.options.map((opt: string, j: number) => (
                      <button class="option-btn" data-option={j}><Fragment set:html={opt} /></button>
                    ))}
                  </div>
                )}

                {q.type === 'free-input' && (
                  <div class="input-group">
                    <input
                      type="text"
                      class="answer-input"
                      placeholder="Type your answer..."
                      autocomplete="off"
                    />
                    <button class="submit-btn">Check</button>
                  </div>
                )}

                {q.type === 'sentence-blocks' && q.blocks && (
                  <div class="blocks-area">
                    <div class="blocks-slots" data-slot-count={q.blocks.length}>
                      {q.blocks.map((_, si: number) => (
                        <div class="block-slot" data-slot-index={si}></div>
                      ))}
                    </div>
                    <div class="blocks-pool">
                      {[...q.blocks, ...(q.distractors ?? [])].map((b, bi: number) => (
                        <button class="block" data-correct-index={bi < (q.blocks?.length ?? 0) ? bi : -1}>
                          <Fragment set:html={b.text} />
                        </button>
                      ))}
                    </div>
                    <div class="blocks-actions">
                      <button class="check-blocks-btn">Check</button>
                      <button class="reset-blocks-btn" type="button">Reset blocks</button>
                    </div>
                  </div>
                )}

                {q.type === 'matching' && q.pairs && (
                  <div class="match-grid">
                    <div class="match-col" data-side="jp">
                      {q.pairs.map((p, pi: number) => (
                        <button class="match-item" data-pair-id={pi} data-side="jp">
                          <Fragment set:html={p.jp} />
                        </button>
                      ))}
                    </div>
                    <div class="match-col" data-side="meaning">
                      {q.pairs.map((p, pi: number) => (
                        <button class="match-item" data-pair-id={pi} data-side="meaning">
                          {p.meaning}
                        </button>
                      ))}
                    </div>
                  </div>
                )}

                <div class="hint">
                  <button class="hint-btn">Show hint</button>
                  <p class="hint-text hidden">{q.hint}</p>
                </div>

                <div class="feedback hidden"></div>
              </div>
            ))}
          </div>

          <button class="reset-btn">Reset</button>
          <div class="results-summary hidden"></div>
        </div>
      </div>
    );
  })()}

  <!-- Navigation -->
  <nav class="section-nav">
    {prevSection ? (
      <a href={`${import.meta.env.BASE_URL}/lesson/${lesson.id}/${prevSection.id}`} class="nav-link prev">
        &larr; {prevSection.title}
      </a>
    ) : <span />}
    {nextSection ? (
      <a href={`${import.meta.env.BASE_URL}/lesson/${lesson.id}/${nextSection.id}`} class="nav-link next">
        {nextSection.title} &rarr;
      </a>
    ) : <span />}
  </nav>
</Layout>

<script>
  import { initAll } from '../../../scripts/quiz';
  initAll();
</script>

