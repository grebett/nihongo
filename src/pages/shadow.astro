</Layout>

<script>
  import WaveSurfer from 'wavesurfer.js';
  import Spectrogram from 'wavesurfer.js/dist/plugins/spectrogram.esm.js';
  import RegionsPlugin from 'wavesurfer.js/dist/plugins/regions.esm.js';
  import type { Region } from 'wavesurfer.js/dist/plugins/regions.esm.js';
  import { YIN } from 'pitchfinder';
  import * as ShadowLib from '../scripts/shadow-library';

  type PitchPoint = {
    time: number;
    freq: number | null;
    rawFreq?: number | null;
    rms?: number;
    confidence?: number;
  };
  type Slot = {
    blob: Blob | null;
    buffer: AudioBuffer | null;
    pitch: PitchPoint[];
    ws: WaveSurfer | null;
    regions: any | null;
    region: Region | null;
    loop: boolean;
  };

  const slots: Record<'ref' | 'rec', Slot> = {
    ref: { blob: null, buffer: null, pitch: [], ws: null, regions: null, region: null, loop: false },
    rec: { blob: null, buffer: null, pitch: [], ws: null, regions: null, region: null, loop: false },
  };

  let lastSelectedSlot: 'ref' | 'rec' = 'ref';

  const audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();

  // Theme-aware colors (read from CSS vars at script eval time)
  const cssVar = (name: string) =>
    getComputedStyle(document.documentElement).getPropertyValue(name).trim();

  function pxVar(name: string, fallback: number): number {
    const raw = cssVar(name);
    const parsed = Number.parseFloat(raw);
    return Number.isFinite(parsed) ? parsed : fallback;
  }

  const colors = {
    ref: '#4a8eb5',
    rec: cssVar('--accent') || '#a8201a',
    grid: cssVar('--border') || '#e6decf',
    axis: cssVar('--text-muted') || '#888',
  };

  const regionColors = {
    ref: {
      idle: 'rgba(74, 142, 181, 0.18)',
      loop: 'rgba(234, 179, 8, 0.32)',
    },
    rec: {
      idle: 'rgba(168, 32, 26, 0.18)',
      loop: 'rgba(234, 179, 8, 0.32)',
    },
  } satisfies Record<'ref' | 'rec', { idle: string; loop: string }>;

  function regionColor(slotKey: 'ref' | 'rec') {
    return slots[slotKey].loop ? regionColors[slotKey].loop : regionColors[slotKey].idle;
  }

  function updateRegionVisual(slotKey: 'ref' | 'rec') {
    const region = slots[slotKey].region as any;
    if (!region) return;
    const color = regionColor(slotKey);
    if (typeof region.setOptions === 'function') {
      region.setOptions({ color });
    } else if (region.element) {
      region.element.style.backgroundColor = color;
    }
  }

  function buildWave(containerId: string, blob: Blob, slotKey: 'ref' | 'rec'): { ws: WaveSurfer; regions: any } {
    const url = URL.createObjectURL(blob);
    const ws = WaveSurfer.create({
      container: `#${containerId}`,
      url,
      waveColor: cssVar('--text-subtle') || '#888',
      progressColor: cssVar('--accent') || '#a8201a',
      cursorColor: cssVar('--text-strong') || '#000',
      height: pxVar('--shadow-waveform-height', 80),
      normalize: true,
    });
    ws.registerPlugin(
      Spectrogram.create({
        labels: true,
        height: pxVar('--shadow-spectrogram-height', 180),
        splitChannels: false,
        scale: 'mel',
        frequencyMax: 4000,
        frequencyMin: 0,
        fftSamples: 1024,
        labelsBackground: 'rgba(0,0,0,0.05)',
      })
    );
    const regions = ws.registerPlugin(RegionsPlugin.create());
    regions.enableDragSelection({ color: regionColors[slotKey].idle });
    return { ws, regions };
  }

  async function decode(blob: Blob): Promise<AudioBuffer> {
    const arr = await blob.arrayBuffer();
    return audioCtx.decodeAudioData(arr.slice(0));
  }

  const PITCH_MIN_HZ = 55;
  const PITCH_MAX_HZ = 650;

  type RawPitchFrame = PitchPoint & {
    candidates?: { yin: number | null; acf: number | null; acfConfidence: number };
  };

  function percentile(xs: number[], p: number): number {
    if (!xs.length) return 0;
    const sorted = [...xs].sort((a, b) => a - b);
    const idx = clamp(Math.round((p / 100) * (sorted.length - 1)), 0, sorted.length - 1);
    return sorted[idx];
  }

  function median(xs: number[]): number {
    return percentile(xs, 50);
  }

  function rmsOf(window: Float32Array): number {
    let sumSq = 0;
    for (let i = 0; i < window.length; i++) sumSq += window[i] * window[i];
    return Math.sqrt(sumSq / Math.max(1, window.length));
  }

  function copyWindowWithoutDc(channel: Float32Array, start: number, size: number): Float32Array {
    const out = new Float32Array(size);
    let mean = 0;
    for (let i = 0; i < size; i++) mean += channel[start + i] || 0;
    mean /= size;
    for (let i = 0; i < size; i++) out[i] = (channel[start + i] || 0) - mean;
    return out;
  }

  function autocorrelationPitch(window: Float32Array, sampleRate: number): { freq: number | null; confidence: number } {
    const minLag = Math.max(2, Math.floor(sampleRate / PITCH_MAX_HZ));
    const maxLag = Math.min(window.length - 2, Math.ceil(sampleRate / PITCH_MIN_HZ));
    let bestLag = 0;
    let bestCorr = -Infinity;

    // Normalized autocorrelation. It is slower than YIN but useful as a fallback
    // for mic recordings where browser processing or low register makes YIN sparse.
    for (let lag = minLag; lag <= maxLag; lag++) {
      let xy = 0;
      let xx = 0;
      let yy = 0;
      for (let i = 0; i + lag < window.length; i++) {
        const x = window[i];
        const y = window[i + lag];
        xy += x * y;
        xx += x * x;
        yy += y * y;
      }
      if (xx <= 0 || yy <= 0) continue;
      const corr = xy / Math.sqrt(xx * yy);
      if (corr > bestCorr) {
        bestCorr = corr;
        bestLag = lag;
      }
    }

    if (!bestLag || bestCorr < 0.38) return { freq: null, confidence: Math.max(0, bestCorr) };

    // Parabolic interpolation around the best lag for a slightly smoother curve.
    let refinedLag = bestLag;
    if (bestLag > minLag && bestLag < maxLag) {
      const corrAt = (lag: number) => {
        let xy = 0;
        let xx = 0;
        let yy = 0;
        for (let i = 0; i + lag < window.length; i++) {
          const x = window[i];
          const y = window[i + lag];
          xy += x * y;
          xx += x * x;
          yy += y * y;
        }
        return xx > 0 && yy > 0 ? xy / Math.sqrt(xx * yy) : 0;
      };
      const left = corrAt(bestLag - 1);
      const center = bestCorr;
      const right = corrAt(bestLag + 1);
      const denom = left - 2 * center + right;
      if (Math.abs(denom) > 1e-6) {
        refinedLag = bestLag + 0.5 * (left - right) / denom;
      }
    }

    const freq = sampleRate / refinedLag;
    return {
      freq: freq >= PITCH_MIN_HZ && freq <= PITCH_MAX_HZ ? freq : null,
      confidence: Math.max(0, Math.min(1, bestCorr)),
    };
  }

  function nearestVoiced(points: PitchPoint[], from: number, dir: -1 | 1, maxSteps: number): number | null {
    for (let i = from + dir, steps = 0; i >= 0 && i < points.length && steps < maxSteps; i += dir, steps++) {
      if (points[i].freq != null) return points[i].freq!;
    }
    return null;
  }

  function octaveCorrect(points: PitchPoint[]): PitchPoint[] {
    const out = points.map((p) => ({ ...p }));
    for (let i = 0; i < out.length; i++) {
      const freq = out[i].freq;
      if (freq == null) continue;
      const prev = nearestVoiced(out, i, -1, 8);
      const next = nearestVoiced(out, i, 1, 8);
      const anchor = prev != null && next != null ? Math.sqrt(prev * next) : prev ?? next;
      if (!anchor) continue;

      let corrected = freq;
      let best = corrected;
      let bestDiff = Math.abs(12 * Math.log2(corrected / anchor));
      for (const factor of [0.25, 0.5, 1, 2, 4]) {
        const candidate = freq * factor;
        if (candidate < PITCH_MIN_HZ || candidate > PITCH_MAX_HZ) continue;
        const diff = Math.abs(12 * Math.log2(candidate / anchor));
        if (diff < bestDiff) {
          best = candidate;
          bestDiff = diff;
        }
      }
      corrected = best;

      // Drop isolated impossible jumps that octave correction cannot rescue.
      const jumpSt = Math.abs(12 * Math.log2(corrected / anchor));
      out[i].freq = jumpSt > 14 ? null : corrected;
    }
    return out;
  }

  function removeIsolatedVoicing(points: PitchPoint[]): PitchPoint[] {
    return points.map((p, i) => {
      if (p.freq == null) return p;
      const hasPrev = nearestVoiced(points, i, -1, 3) != null;
      const hasNext = nearestVoiced(points, i, 1, 3) != null;
      return hasPrev || hasNext ? p : { ...p, freq: null };
    });
  }

  function medianSmoothPitch(points: PitchPoint[], radius = 2): PitchPoint[] {
    return points.map((p, i) => {
      if (p.freq == null) return p;
      const vals: number[] = [];
      for (let j = Math.max(0, i - radius); j <= Math.min(points.length - 1, i + radius); j++) {
        if (points[j].freq != null) vals.push(points[j].freq!);
      }
      if (vals.length < 3) return p;
      return { ...p, freq: median(vals) };
    });
  }

  function fillShortPitchGaps(points: PitchPoint[], maxGapFrames = 5, maxJumpSt = 7): PitchPoint[] {
    const out = points.map((p) => ({ ...p }));
    let i = 0;
    while (i < out.length) {
      if (out[i].freq != null) {
        i++;
        continue;
      }
      const gapStart = i;
      while (i < out.length && out[i].freq == null) i++;
      const gapEnd = i - 1;
      const left = gapStart - 1;
      const right = gapEnd + 1;
      const gapLen = gapEnd - gapStart + 1;
      if (
        gapLen <= maxGapFrames &&
        left >= 0 &&
        right < out.length &&
        out[left].freq != null &&
        out[right].freq != null
      ) {
        const f1 = out[left].freq!;
        const f2 = out[right].freq!;
        const jumpSt = Math.abs(12 * Math.log2(f2 / f1));
        if (jumpSt <= maxJumpSt) {
          const log1 = Math.log(f1);
          const log2 = Math.log(f2);
          for (let k = 1; k <= gapLen; k++) {
            const alpha = k / (gapLen + 1);
            out[left + k].freq = Math.exp(log1 + alpha * (log2 - log1));
          }
        }
      }
    }
    return out;
  }

  function extractPitch(buffer: AudioBuffer): PitchPoint[] {
    const sampleRate = buffer.sampleRate;
    const detector = YIN({ sampleRate, threshold: 0.12 } as any);
    const channel = buffer.getChannelData(0);

    // Longer windows help low male voices and browser-recorded audio. Hop stays
    // short enough to keep visible timing detail for shadowing.
    const windowSize = Math.min(4096, Math.max(2048, Math.round(sampleRate * 0.085)));
    const hopSize = Math.max(256, Math.round(sampleRate * 0.01));

    const windows: { start: number; time: number; window: Float32Array; rms: number }[] = [];
    for (let start = 0; start + windowSize < channel.length; start += hopSize) {
      const window = copyWindowWithoutDc(channel, start, windowSize);
      windows.push({
        start,
        time: (start + windowSize / 2) / sampleRate,
        window,
        rms: rmsOf(window),
      });
    }

    const rmsValues = windows.map((w) => w.rms).filter((v) => Number.isFinite(v));
    const rmsP90 = percentile(rmsValues, 90);
    const rmsP15 = percentile(rmsValues, 15);
    const rmsGate = Math.max(rmsP90 * 0.025, rmsP15 * 2.0, 0.0008);

    const raw: RawPitchFrame[] = windows.map(({ time, window, rms }) => {
      if (rms < rmsGate) return { time, freq: null, rawFreq: null, rms, confidence: 0 };

      const yinRaw = detector(window);
      const yin = yinRaw && yinRaw >= PITCH_MIN_HZ && yinRaw <= PITCH_MAX_HZ ? yinRaw : null;
      const acf = autocorrelationPitch(window, sampleRate);

      // Prefer YIN when available; otherwise use ACF as a conservative fallback.
      // If they disagree by almost an octave, the post-processor will correct it.
      const freq = yin ?? acf.freq;
      const confidence = yin ? Math.max(0.62, acf.confidence) : acf.confidence;
      return {
        time,
        freq,
        rawFreq: freq,
        rms,
        confidence,
        candidates: { yin, acf: acf.freq, acfConfidence: acf.confidence },
      };
    });

    let cleaned: PitchPoint[] = raw.map(({ time, freq, rawFreq, rms, confidence }) => ({
      time,
      freq,
      rawFreq,
      rms,
      confidence,
    }));

    cleaned = octaveCorrect(cleaned);
    cleaned = removeIsolatedVoicing(cleaned);
    cleaned = fillShortPitchGaps(cleaned, 5, 7);
    cleaned = medianSmoothPitch(cleaned, 2);
    cleaned = octaveCorrect(cleaned);
    cleaned = removeIsolatedVoicing(cleaned);

    return cleaned;
  }

  function fitCanvas(canvas: HTMLCanvasElement) {
    const ratio = window.devicePixelRatio || 1;
    const w = canvas.clientWidth;
    const h = canvas.clientHeight;
    if (canvas.width !== w * ratio || canvas.height !== h * ratio) {
      canvas.width = w * ratio;
      canvas.height = h * ratio;
      const ctx = canvas.getContext('2d')!;
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
    }
  }

  type Series = {
    points: PitchPoint[];
    color: string;
    offset?: number;       // seconds, added to each point's time
    scale?: number;        // multiplier on time
    pitchShiftSt?: number; // vertical pitch offset in semitones
    label?: string;
  };

  type WaveformOverlay = {
    buffer: AudioBuffer | null;
    color: string;
    offset?: number;
    scale?: number;
    lane: 'top' | 'bottom';
    label?: string;
  };

  // Cached layout from the last draw on the compare canvas — used by the drag handler
  // to convert pixel deltas to seconds and vertical pixel movement to semitones.
  let lastCompareLayout: {
    tMax: number;
    w: number;
    h: number;
    padX: number;
    usableH: number;
    pitchRangeSt: number;
  } | null = null;

  function clamp(n: number, min: number, max: number): number {
    return Math.max(min, Math.min(max, n));
  }

  function semitoneFactor(st: number): number {
    return Math.pow(2, st / 12);
  }

  function transformedTime(p: PitchPoint, s: Series) {
    return p.time * (s.scale ?? 1) + (s.offset ?? 0);
  }

  function transformedFreq(p: PitchPoint, s: Series): number | null {
    if (p.freq == null) return null;
    return p.freq * semitoneFactor(s.pitchShiftSt ?? 0);
  }

  function seriesTimeMax(s: Series): number {
    const last = s.points[s.points.length - 1];
    return last ? transformedTime(last, s) : 0;
  }

  function drawPitchCurve(
    canvas: HTMLCanvasElement,
    series: Series[],
    opts: {
      fMin?: number;
      fMax?: number;
      tMax?: number;
      cacheLayout?: boolean;
      waveformOverlays?: WaveformOverlay[];
    } = {}
  ) {
    fitCanvas(canvas);
    const ctx = canvas.getContext('2d')!;
    const w = canvas.clientWidth;
    const h = canvas.clientHeight;
    const padX = 36;
    const padY = 10;
    const usableH = Math.max(1, h - padY * 2);
    ctx.clearRect(0, 0, w, h);

    // Auto-range based on transformed pitch values. Y is logarithmic/semitone-based,
    // so +12 st is an octave everywhere, instead of a fixed number of Hz.
    const allFreqs = series.flatMap((s) =>
      s.points
        .map((p) => transformedFreq(p, s))
        .filter((f): f is number => f != null && Number.isFinite(f) && f > 0)
    );
    if (allFreqs.length === 0) {
      ctx.fillStyle = colors.axis;
      ctx.font = '12px Inter, sans-serif';
      ctx.fillText('Pas de pitch détecté', 10, 20);
      return;
    }

    const rawMin = Math.min(...allFreqs);
    const rawMax = Math.max(...allFreqs);
    const fMin = opts.fMin ?? Math.max(50, rawMin / semitoneFactor(2));
    const fMax = opts.fMax ?? Math.min(900, rawMax * semitoneFactor(2));
    const logMin = Math.log2(fMin);
    const logMax = Math.log2(Math.max(fMax, fMin * 1.01));
    const pitchRangeSt = Math.max(1, 12 * (logMax - logMin));
    const tMax = opts.tMax ?? Math.max(0.1, ...series.map(seriesTimeMax));
    if (tMax === 0) return;

    if (opts.cacheLayout) lastCompareLayout = { tMax, w, h, padX, usableH, pitchRangeSt };

    const yForFreq = (freq: number) => {
      const normalized = (Math.log2(freq) - logMin) / (logMax - logMin);
      return h - normalized * usableH - padY;
    };

    if (opts.waveformOverlays?.length) {
      drawWaveformOverlays(ctx, opts.waveformOverlays, { w, h, padX, tMax });
    }

    // Grid
    ctx.strokeStyle = colors.grid;
    ctx.lineWidth = 1;
    ctx.font = '10px Inter, sans-serif';
    ctx.fillStyle = colors.axis;
    const fSteps = 4;
    for (let i = 0; i <= fSteps; i++) {
      const logF = logMin + (i / fSteps) * (logMax - logMin);
      const f = Math.pow(2, logF);
      const y = yForFreq(f);
      ctx.beginPath();
      ctx.moveTo(padX, y);
      ctx.lineTo(w, y);
      ctx.stroke();
      ctx.fillText(`${Math.round(f)} Hz`, 2, y + 3);
    }

    // Curves — gap-aware (don't connect unvoiced regions)
    for (const s of series) {
      ctx.strokeStyle = s.color;
      ctx.lineWidth = 2;
      ctx.beginPath();
      let pen = false;
      for (const p of s.points) {
        const freq = transformedFreq(p, s);
        if (freq == null) {
          pen = false;
          continue;
        }
        const t = transformedTime(p, s);
        if (t < 0) {
          pen = false;
          continue;
        }
        const x = padX + (t / tMax) * (w - padX);
        const y = yForFreq(freq);
        if (!pen) {
          ctx.moveTo(x, y);
          pen = true;
        } else {
          ctx.lineTo(x, y);
        }
      }
      ctx.stroke();
    }
  }

  function drawWaveformOverlays(
    ctx: CanvasRenderingContext2D,
    overlays: WaveformOverlay[],
    layout: { w: number; h: number; padX: number; tMax: number }
  ) {
    const { w, h, padX, tMax } = layout;
    const plotW = Math.max(1, w - padX);
    const laneCenter = {
      top: h * 0.22,
      bottom: h * 0.78,
    } satisfies Record<WaveformOverlay['lane'], number>;
    const laneAmp = Math.max(14, Math.min(34, h * 0.12));

    ctx.save();
    ctx.lineWidth = 1;

    for (const overlay of overlays) {
      const buffer = overlay.buffer;
      if (!buffer || buffer.duration <= 0) continue;
      const channel = buffer.getChannelData(0);
      const sampleRate = buffer.sampleRate;
      const offset = overlay.offset ?? 0;
      const scale = overlay.scale ?? 1;
      if (!Number.isFinite(scale) || scale <= 0) continue;

      const baseY = laneCenter[overlay.lane];

      ctx.globalAlpha = 0.12;
      ctx.strokeStyle = overlay.color;
      ctx.beginPath();
      ctx.moveTo(padX, baseY);
      ctx.lineTo(w, baseY);
      ctx.stroke();

      if (overlay.label) {
        ctx.globalAlpha = 0.42;
        ctx.font = '10px Inter, sans-serif';
        ctx.fillStyle = overlay.color;
        ctx.fillText(overlay.label, padX + 6, baseY - laneAmp - 4);
      }

      ctx.globalAlpha = 0.28;
      ctx.strokeStyle = overlay.color;
      ctx.beginPath();

      let hasLine = false;
      for (let x = Math.floor(padX); x <= Math.floor(w); x++) {
        const displayT0 = ((x - padX) / plotW) * tMax;
        const displayT1 = ((x + 1 - padX) / plotW) * tMax;
        const audioT0 = (displayT0 - offset) / scale;
        const audioT1 = (displayT1 - offset) / scale;
        const fromT = Math.min(audioT0, audioT1);
        const toT = Math.max(audioT0, audioT1);
        if (toT < 0 || fromT > buffer.duration) continue;

        const start = clamp(Math.floor(Math.max(0, fromT) * sampleRate), 0, channel.length - 1);
        const end = clamp(Math.ceil(Math.min(buffer.duration, toT) * sampleRate), start + 1, channel.length);
        const span = Math.max(1, end - start);
        const sampleStep = Math.max(1, Math.floor(span / 80));
        let min = 1;
        let max = -1;
        for (let i = start; i < end; i += sampleStep) {
          const v = channel[i];
          if (v < min) min = v;
          if (v > max) max = v;
        }

        if (min > max) continue;
        const yMin = baseY - max * laneAmp;
        const yMax = baseY - min * laneAmp;
        ctx.moveTo(x, yMin);
        ctx.lineTo(x, yMax);
        hasLine = true;
      }

      if (hasLine) ctx.stroke();
    }

    ctx.restore();
  }

  async function loadIntoSlot(slotKey: 'ref' | 'rec', blob: Blob, opts: { autoplay?: boolean } = {}) {
    const slot = slots[slotKey];
    if (slot.ws) {
      slot.ws.destroy();
      slot.ws = null;
      slot.regions = null;
      slot.region = null;
    }
    slot.blob = blob;

    const waveContainerId = slotKey === 'ref' ? 'ref-wave' : 'rec-wave';
    const pitchCanvas = document.getElementById(
      slotKey === 'ref' ? 'ref-pitch' : 'rec-pitch'
    ) as HTMLCanvasElement;
    const status = document.getElementById(slotKey === 'ref' ? 'ref-status' : 'rec-status')!;
    const playBtn = document.getElementById(slotKey === 'ref' ? 'ref-play' : 'rec-play') as HTMLButtonElement;
    const loopBtn = document.getElementById(slotKey === 'ref' ? 'ref-loop' : 'rec-loop') as HTMLButtonElement;

    playBtn.disabled = true;
    playBtn.textContent = '▶ Play';
    slot.loop = false;
    loopBtn.disabled = true;
    loopBtn.classList.remove('active');
    loopBtn.setAttribute('aria-pressed', 'false');

    status.textContent = 'Décodage…';

    const built = buildWave(waveContainerId, blob, slotKey);
    slot.ws = built.ws;
    slot.regions = built.regions;

    // Single-region mode: any new region replaces the previous one.
    slot.regions.on('region-created', (region: Region) => {
      for (const r of slot.regions.getRegions()) if (r !== region) r.remove();
      slot.region = region;
      loopBtn.disabled = false;
      updateRegionVisual(slotKey);
    });
    slot.regions.on('region-updated', (region: Region) => {
      slot.region = region;
    });
    slot.regions.on('region-removed', () => {
      slot.region = null;
      // Disable loop only if no region remains
      if (!slot.regions.getRegions().length) {
        loopBtn.disabled = true;
        slot.loop = false;
        loopBtn.classList.remove('active');
        loopBtn.setAttribute('aria-pressed', 'false');
      }
    });
    // Only the loop mode owns region playback.
    // When loop is off, Play should ignore the selection and play the full audio.
    slot.regions.on('region-out', (region: Region) => {
      if (slot.region === region && slot.loop) {
        region.play();
      }
    });

    slot.ws.on('ready', () => {
      playBtn.disabled = false;
      if (opts.autoplay && slot.ws) {
        void slot.ws.play();
        setPlayButtonPlaying(slotKey, true);
      }
    });
    slot.ws.on('play', () => setPlayButtonPlaying(slotKey, true));
    slot.ws.on('pause', () => setPlayButtonPlaying(slotKey, false));
    slot.ws.on('finish', () => setPlayButtonPlaying(slotKey, false));

    slot.buffer = await decode(blob);
    status.textContent = 'Extraction du pitch…';
    slot.pitch = extractPitch(slot.buffer);

    drawPitchCurve(pitchCanvas, [
      { points: slot.pitch, color: slotKey === 'ref' ? colors.ref : colors.rec },
    ]);

    const voiced = slot.pitch.filter((p) => p.freq).length;
    status.textContent = `Durée ${slot.buffer.duration.toFixed(2)}s · ${voiced}/${slot.pitch.length} frames voicées · glisse sur la waveform pour sélectionner une portion`;

    // Enable compare button if both loaded
    if (slots.ref.pitch.length && slots.rec.pitch.length) {
      (document.getElementById('compare-btn') as HTMLButtonElement).disabled = false;
    }
  }

  function playButtonFor(slotKey: 'ref' | 'rec'): HTMLButtonElement {
    return document.getElementById(slotKey === 'ref' ? 'ref-play' : 'rec-play') as HTMLButtonElement;
  }

  function setPlayButtonPlaying(slotKey: 'ref' | 'rec', playing: boolean) {
    playButtonFor(slotKey).textContent = playing ? '❚❚ Pause' : '▶ Play';
  }

  async function toggleSlotPlayback(slotKey: 'ref' | 'rec') {
    const slot = slots[slotKey];
    const ws = slot.ws;
    if (!ws) return;

    lastSelectedSlot = slotKey;
    if (audioCtx.state === 'suspended') await audioCtx.resume();

    if (ws.isPlaying()) {
      ws.pause();
      setPlayButtonPlaying(slotKey, false);
      return;
    }

    if (slot.loop && slot.region) {
      slot.region.play();
    } else {
      void ws.play();
    }
    setPlayButtonPlaying(slotKey, true);
  }

  function shouldIgnorePlaybackShortcut(target: EventTarget | null): boolean {
    const el = target as HTMLElement | null;
    return !!el?.closest('input, textarea, select, button, a, [contenteditable="true"]');
  }

  function setupSpacePlaybackShortcut() {
    document.addEventListener('keydown', (e) => {
      if (e.code !== 'Space' || e.repeat) return;
      if (shouldIgnorePlaybackShortcut(e.target)) return;
      if (!slots[lastSelectedSlot].ws) return;
      e.preventDefault();
      void toggleSlotPlayback(lastSelectedSlot);
    });
  }

  type ReferenceTab = 'files' | 'phrases';

  function setReferenceTab(tab: ReferenceTab) {
    document.querySelectorAll<HTMLButtonElement>('[data-reference-tab]').forEach((btn) => {
      const active = btn.dataset.referenceTab === tab;
      btn.classList.toggle('active', active);
      btn.setAttribute('aria-selected', active ? 'true' : 'false');
    });

    document.querySelectorAll<HTMLElement>('[data-reference-tab-panel]').forEach((panel) => {
      panel.classList.toggle('active', panel.dataset.referenceTabPanel === tab);
    });
  }

  function setupReferenceTabs() {
    document.querySelectorAll<HTMLButtonElement>('[data-reference-tab]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const tab = btn.dataset.referenceTab as ReferenceTab | undefined;
        if (tab) setReferenceTab(tab);
      });
    });
  }

  function setupPlayLoop(slotKey: 'ref' | 'rec') {
    const slot = slots[slotKey];
    const playBtn = playButtonFor(slotKey);
    const loopBtn = document.getElementById(slotKey === 'ref' ? 'ref-loop' : 'rec-loop') as HTMLButtonElement;

    playBtn.addEventListener('click', () => {
      void toggleSlotPlayback(slotKey);
    });

    loopBtn.addEventListener('click', () => {
      lastSelectedSlot = slotKey;
      slot.loop = !slot.loop;
      loopBtn.classList.toggle('active', slot.loop);
      loopBtn.setAttribute('aria-pressed', slot.loop ? 'true' : 'false');
      updateRegionVisual(slotKey);
    });
  }

  // ─── Reference: file upload + folder browser ───
  document.getElementById('ref-file')!.addEventListener('change', async (e) => {
    const f = (e.target as HTMLInputElement).files?.[0];
    if (!f) return;
    folderState.activeName = null; // upload bypasses any folder selection
    lastSelectedSlot = 'ref';
    renderTree();
    renderPhrasePanel(null);
    await loadIntoSlot('ref', f);
  });

  setupPlayLoop('ref');
  setupPlayLoop('rec');
  setupSpacePlaybackShortcut();
  setupReferenceTabs();

  // Folder browser — tree state
  type TreeNode = {
    name: string;
    path: string;       // joined webkitRelativePath up to this node
    isDir: boolean;
    children?: TreeNode[];
    file?: File;
  };

  const folderState: {
    tree: TreeNode | null;
    activeName: string | null;
    rootName: string;
    totalFiles: number;
  } = { tree: null, activeName: null, rootName: '', totalFiles: 0 };

  const expanded = new Set<string>();
  const AUDIO_EXT_RE = /\.(mp3|wav|m4a|aac|ogg|opus|webm|flac)$/i;

  function fmtSize(bytes: number): string {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(0) + ' KB';
    return (bytes / 1024 / 1024).toFixed(1) + ' MB';
  }

  function buildTree(files: File[]): TreeNode {
    const root: TreeNode = { name: '', path: '', isDir: true, children: [] };
    for (const f of files) {
      const parts = f.webkitRelativePath.split('/');
      let cur = root;
      for (let i = 0; i < parts.length; i++) {
        const isLast = i === parts.length - 1;
        const name = parts[i];
        const path = parts.slice(0, i + 1).join('/');
        let node = cur.children!.find((c) => c.name === name);
        if (!node) {
          node = isLast
            ? { name, path, isDir: false, file: f }
            : { name, path, isDir: true, children: [] };
          cur.children!.push(node);
        }
        cur = node;
      }
    }
    // Sort: folders before files, then numeric-aware alphabetical
    const sortRec = (node: TreeNode) => {
      if (!node.children) return;
      node.children.sort((a, b) => {
        if (a.isDir !== b.isDir) return a.isDir ? -1 : 1;
        return a.name.localeCompare(b.name, undefined, { numeric: true });
      });
      node.children.forEach(sortRec);
    };
    sortRec(root);
    return root;
  }

  function countAudioFiles(node: TreeNode): number {
    if (!node.isDir) return 1;
    return (node.children || []).reduce((s, c) => s + countAudioFiles(c), 0);
  }

  function renderTree() {
    const list = document.getElementById('ref-file-list')!;
    list.innerHTML = '';
    if (!folderState.tree) return;
    const children = folderState.tree.children || [];
    children.forEach((c, i) => renderNode(c, list, '', i === children.length - 1));
  }

  // Renders one node with `tree(1)`-style box-drawing prefix.
  //   prefix : the accumulated indentation built up through ancestors
  //            ('│   ' for ancestor levels with more siblings, '    ' otherwise)
  //   isLast : whether this node is the last child of its parent
  function renderNode(node: TreeNode, parent: HTMLElement, prefix: string, isLast: boolean) {
    const branch = isLast ? '└── ' : '├── ';
    const marker = node.isDir ? (expanded.has(node.path) ? '▾ ' : '▸ ') : '♪ ';

    const row = document.createElement('div');
    row.className = 'tree-row ' + (node.isDir ? 'is-dir' : 'is-file');
    if (!node.isDir && folderState.activeName === node.path) row.classList.add('active');

    row.innerHTML = '<span class="indent"></span><span class="name"></span><span class="meta"></span>';
    (row.querySelector('.indent') as HTMLElement).textContent = prefix + branch + marker;
    (row.querySelector('.name') as HTMLElement).textContent = node.name;
    (row.querySelector('.meta') as HTMLElement).textContent = node.isDir
      ? String(countAudioFiles(node))
      : fmtSize(node.file!.size);

    if (node.isDir) {
      row.addEventListener('click', () => {
        if (expanded.has(node.path)) expanded.delete(node.path);
        else expanded.add(node.path);
        renderTree();
      });
    } else {
      row.addEventListener('click', async () => {
        folderState.activeName = node.path;
        lastSelectedSlot = 'ref';
        renderTree();
        // First check the in-memory map (Safari fallback path). If empty and we
        // have a library xmlDir, lazy-load the corresponding XML now.
        let phrase = findPhraseFor(node.file!);
        if (!phrase && libState.xmlDir) {
          await lazyLoadXmlForFile(node.file!);
          phrase = findPhraseFor(node.file!);
        }
        renderPhrasePanel(phrase);
        renderPhrasesList(); // refresh active highlight in the phrases list
        await loadIntoSlot('ref', node.file!);
      });
    }
    parent.appendChild(row);

    if (node.isDir && expanded.has(node.path)) {
      const childPrefix = prefix + (isLast ? '    ' : '│   ');
      const children = node.children || [];
      children.forEach((c, i) => renderNode(c, parent, childPrefix, i === children.length - 1));
    }
  }

  function loadAudioFolderFromFiles(audioInput: File[], rootName?: string) {
    const audio = audioInput.filter((f) => AUDIO_EXT_RE.test(f.name));
    if (!audio.length) {
      alert('Aucun fichier audio trouvé dans ce dossier.');
      return;
    }
    folderState.tree = buildTree(audio);
    folderState.activeName = null;
    folderState.totalFiles = audio.length;
    folderState.rootName = rootName || audio[0].webkitRelativePath.split('/')[0];

    expanded.clear();
    const topChildren = folderState.tree.children || [];
    if (topChildren.length === 1 && topChildren[0].isDir) {
      expanded.add(topChildren[0].path);
    }

    const panel = document.getElementById('ref-folder-panel')!;
    panel.classList.remove('hidden');
    (document.getElementById('ref-folder-name') as HTMLElement).textContent = folderState.rootName;
    (document.getElementById('ref-folder-count') as HTMLElement).textContent =
      `${audio.length} audio${audio.length > 1 ? 's' : ''}`;
    renderTree();
    setReferenceTab('files');
  }

  // Note: the ref-folder input is now wired only as the Safari/Firefox fallback
  // for the 📚 Library button (see the FS API detection block lower down).

  document.getElementById('ref-folder-clear')!.addEventListener('click', () => {
    folderState.tree = null;
    folderState.activeName = null;
    folderState.rootName = '';
    folderState.totalFiles = 0;
    expanded.clear();
    document.getElementById('ref-folder-panel')!.classList.add('hidden');
    document.getElementById('ref-phrase')!.classList.add('hidden');
    (document.getElementById('ref-folder') as HTMLInputElement).value = '';
    setReferenceTab('files');
  });

  // ─── XML phrase index (Assimil lessons) ───
  type PhraseData = {
    lessonId: string;   // from <lesson id="...">
    num: string;        // <phrase num="...">
    audioFile: string;  // value of <tt audio="...">
    jpHtml: string;     // raw innerHTML of <tt> (preserves <ruby>/<rt>)
    ph: string;         // <ph> content (often phonetic transliteration)
    trlat: string;      // <trlat> content (translation)
  };

  // Map keyed by `${lessonId}/${audioFile}` → phrase data
  const phraseMap = new Map<string, PhraseData>();

  function parseLessonXml(xmlString: string): PhraseData[] {
    const doc = new DOMParser().parseFromString(xmlString, 'application/xml');
    if (doc.querySelector('parsererror')) return [];
    const lessonId = doc.querySelector('lesson')?.getAttribute('id') || '';
    if (!lessonId) return [];

    const out: PhraseData[] = [];
    for (const phrase of Array.from(doc.querySelectorAll('phrase'))) {
      const tt = phrase.querySelector('tt');
      if (!tt) continue;
      const audioFile = tt.getAttribute('audio');
      if (!audioFile) continue;
      out.push({
        lessonId,
        num: phrase.getAttribute('num') || '',
        audioFile,
        jpHtml: tt.innerHTML,
        ph: phrase.querySelector('ph')?.textContent?.trim() || '',
        trlat: phrase.querySelector('trlat')?.textContent?.trim() || '',
      });
    }
    return out;
  }

  async function indexXmls(files: File[]) {
    const xmls = files.filter((f) => f.name.toLowerCase().endsWith('.xml'));
    if (!xmls.length) {
      alert('Aucun fichier .xml trouvé.');
      return;
    }
    phraseMap.clear();
    let lessonsParsed = 0;
    for (const f of xmls) {
      try {
        const text = await f.text();
        const phrases = parseLessonXml(text);
        if (phrases.length === 0) continue;
        lessonsParsed++;
        for (const p of phrases) {
          phraseMap.set(`${p.lessonId}/${p.audioFile}`, p);
        }
      } catch (err) {
        console.warn('XML parse failed', f.name, err);
      }
    }
    const status = document.getElementById('xml-status')!;
    status.classList.remove('hidden');
    status.innerHTML = `<span class="ok">✓</span> ${phraseMap.size} phrases indexées (${lessonsParsed} leçon${lessonsParsed > 1 ? 's' : ''}, ${xmls.length} fichier${xmls.length > 1 ? 's' : ''} XML)`;

    if (folderState.activeName) {
      const active = findActiveFile();
      if (active) renderPhrasePanel(findPhraseFor(active));
    }
  }

  // (XML files are no longer picked separately — they're discovered via the library
  // root + xmlSubpath config, either upfront in the Safari fallback or lazily on
  // audio click in the Chromium FS API path.)

  function findActiveFile(): File | null {
    if (!folderState.tree || !folderState.activeName) return null;
    const target = folderState.activeName;
    function walk(node: TreeNode): File | null {
      if (!node.isDir) {
        return node.path === target ? node.file! : null;
      }
      for (const c of node.children || []) {
        const f = walk(c);
        if (f) return f;
      }
      return null;
    }
    return walk(folderState.tree);
  }

  function findPhraseFor(file: File): PhraseData | null {
    if (!file.webkitRelativePath) return null;
    const parts = file.webkitRelativePath.split('/');
    if (parts.length < 2) return null;
    // Audio file's parent directory name = lesson ID (Assimil convention: L001/N1.mp3)
    const lessonId = parts[parts.length - 2];
    const fileName = parts[parts.length - 1];
    return phraseMap.get(`${lessonId}/${fileName}`) || null;
  }

  // Look up the lesson ID from the file's path (parent directory),
  // load the matching XML on demand from the library's xmlDir, parse it,
  // and merge results into phraseMap so subsequent clicks are instant.
  async function lazyLoadXmlForFile(file: File): Promise<void> {
    if (!libState.xmlDir || !file.webkitRelativePath) return;
    const parts = file.webkitRelativePath.split('/');
    if (parts.length < 2) return;
    const lessonId = parts[parts.length - 2];
    // Skip if we already have any phrase for this lesson
    for (const key of phraseMap.keys()) {
      if (key.startsWith(lessonId + '/')) return;
    }
    const xmlText = await ShadowLib.readXmlByLessonId(
      libState.xmlDir,
      lessonId,
      libState.xmlFilenameTemplate,
    );
    if (!xmlText) return;
    const phrases = parseLessonXml(xmlText);
    for (const p of phrases) phraseMap.set(`${p.lessonId}/${p.audioFile}`, p);
  }

  function renderPhrasePanel(phrase: PhraseData | null) {
    const panel = document.getElementById('ref-phrase')!;
    if (!phrase) {
      panel.classList.add('hidden');
      return;
    }
    panel.classList.remove('hidden');
    const meta = document.getElementById('phrase-meta')!;
    const jp = document.getElementById('phrase-jp')!;
    const ph = document.getElementById('phrase-ph')!;
    const fr = document.getElementById('phrase-fr')!;
    meta.textContent = `${phrase.lessonId} · phrase ${phrase.num}`;
    jp.innerHTML = phrase.jpHtml; // trusted: comes from local XML files the user picked
    ph.textContent = phrase.ph;
    fr.textContent = phrase.trlat;
  }

  // ─── Recording ───
  let mediaRecorder: MediaRecorder | null = null;
  let chunks: Blob[] = [];
  const recStart = document.getElementById('rec-start') as HTMLButtonElement;
  const recStop = document.getElementById('rec-stop') as HTMLButtonElement;
  const recStatus = document.getElementById('rec-status')!;

  // Short beeps for the countdown — 880 Hz "tic" + 1320 Hz "go".
  function beep(freq: number, duration = 0.12, volume = 0.18) {
    const t = audioCtx.currentTime;
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.frequency.value = freq;
    osc.type = 'sine';
    gain.gain.setValueAtTime(volume, t);
    gain.gain.exponentialRampToValueAtTime(0.001, t + duration);
    osc.connect(gain).connect(audioCtx.destination);
    osc.start(t);
    osc.stop(t + duration + 0.02);
  }

  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

  async function runCountdown() {
    const overlay = document.getElementById('countdown-overlay')!;
    const num = document.getElementById('countdown-num')!;
    overlay.classList.remove('hidden');
    const popAnim = () =>
      num.animate(
        [
          { transform: 'scale(0.7)', opacity: 0 },
          { transform: 'scale(1.1)', opacity: 1, offset: 0.55 },
          { transform: 'scale(1)', opacity: 1 },
        ],
        { duration: 380, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' }
      );
    for (const n of [3, 2, 1]) {
      num.className = 'countdown-num';
      num.textContent = String(n);
      popAnim();
      beep(880);
      await sleep(1000);
    }
    num.className = 'countdown-num go';
    num.textContent = 'GO';
    popAnim();
    beep(1320, 0.18, 0.22);
    await sleep(450);
    overlay.classList.add('hidden');
  }

  recStart.addEventListener('click', async () => {
    let stream: MediaStream;
    try {
      stream = await navigator.mediaDevices.getUserMedia({
        audio: {
          echoCancellation: false,
          noiseSuppression: false,
          autoGainControl: false,
          channelCount: 1,
        },
      });
    } catch (primaryErr: any) {
      // Some browsers/devices reject specific audio constraints. Fall back to
      // the default mic so recording still works, but prefer the clean path above
      // because browser voice processing can break F0 tracking.
      try {
        stream = await navigator.mediaDevices.getUserMedia({ audio: true });
        console.warn('Falling back to default mic constraints', primaryErr);
      } catch (err: any) {
        recStatus.textContent = `Erreur micro : ${err.message || err}`;
        return;
      }
    }
    // Resume AudioContext if it was suspended (Safari/Chrome autoplay policy).
    if (audioCtx.state === 'suspended') await audioCtx.resume();

    recStart.disabled = true;
    recStatus.textContent = 'Préparation…';

    await runCountdown();

    chunks = [];
    const mimeCandidates = ['audio/webm;codecs=opus', 'audio/webm', 'audio/mp4'];
    const mime = mimeCandidates.find((m) => MediaRecorder.isTypeSupported(m)) || '';
    mediaRecorder = new MediaRecorder(stream, mime ? { mimeType: mime } : undefined);
    mediaRecorder.ondataavailable = (e) => {
      if (e.data.size > 0) chunks.push(e.data);
    };
    mediaRecorder.onstop = async () => {
      stream.getTracks().forEach((t) => t.stop());
      const blob = new Blob(chunks, { type: mediaRecorder!.mimeType || 'audio/webm' });
      await loadIntoSlot('rec', blob);
    };
    mediaRecorder.start();
    recStop.disabled = false;
    recStatus.textContent = '🔴 Enregistrement…';
  });

  recStop.addEventListener('click', () => {
    if (mediaRecorder && mediaRecorder.state !== 'inactive') {
      mediaRecorder.stop();
    }
    recStart.disabled = false;
    recStop.disabled = true;
  });

  // ─── Compare + manual alignment ───
  let recOffset = 0; // seconds
  let recScale = 1;
  let recPitchShiftSt = 0; // semitones, applied multiplicatively to rec F0
  let showWaveformOverlay = false;
  let comparedOnce = false;

  const compareCanvas = document.getElementById('compare-pitch') as HTMLCanvasElement;
  const scaleSlider = document.getElementById('scale-slider') as HTMLInputElement;
  const pitchShiftSlider = document.getElementById('pitch-shift-slider') as HTMLInputElement;
  const waveformOverlayToggle = document.getElementById('show-waveform-overlay') as HTMLInputElement;
  const scaleVal = document.getElementById('scale-val')!;
  const pitchShiftVal = document.getElementById('pitch-shift-val')!;
  const offsetVal = document.getElementById('offset-val')!;
  const resetBtn = document.getElementById('reset-align-btn') as HTMLButtonElement;
  const autoBtn = document.getElementById('auto-align-btn') as HTMLButtonElement;

  function formatSigned(n: number, digits = 1): string {
    const sign = n > 0 ? '+' : '';
    return sign + n.toFixed(digits);
  }

  function syncCompareControls() {
    offsetVal.textContent = recOffset.toFixed(2);
    scaleVal.textContent = recScale.toFixed(2);
    pitchShiftVal.textContent = formatSigned(recPitchShiftSt, 1);
    if (scaleSlider.value !== String(recScale)) scaleSlider.value = String(recScale);
    if (pitchShiftSlider.value !== String(recPitchShiftSt)) pitchShiftSlider.value = recPitchShiftSt.toFixed(1);
    waveformOverlayToggle.checked = showWaveformOverlay;
  }

  function redrawCompare() {
    if (!comparedOnce) return;
    drawPitchCurve(
      compareCanvas,
      [
        { points: slots.ref.pitch, color: colors.ref },
        {
          points: slots.rec.pitch,
          color: colors.rec,
          offset: recOffset,
          scale: recScale,
          pitchShiftSt: recPitchShiftSt,
        },
      ],
      {
        cacheLayout: true,
        waveformOverlays: showWaveformOverlay
          ? [
              { buffer: slots.ref.buffer, color: colors.ref, lane: 'top', label: 'Réf' },
              {
                buffer: slots.rec.buffer,
                color: colors.rec,
                offset: recOffset,
                scale: recScale,
                lane: 'bottom',
                label: 'Voix',
              },
            ]
          : undefined,
      }
    );
    syncCompareControls();
    renderAnalysis();
  }

  // ─── Analysis ───
  type Analysis = {
    correlation: number;          // Pearson on log-pitch (overlap, voiced both)
    directionAgreement: number;   // 0..1
    rmsSemitones: number;         // RMS distance after centering each by its own mean log-F0
    refRangeSt: number;           // pitch range in semitones
    recRangeSt: number;
    refMeanF0: number;
    recMeanF0: number;
    recMeanF0Raw: number;
    refVoicedRatio: number;
    recVoicedRatio: number;
    overlapFrames: number;
  };

  function pitchAnalysis(): Analysis | null {
    const ref = slots.ref.pitch;
    const rec = slots.rec.pitch;
    if (!ref.length || !rec.length) return null;

    const refHop = ref.length > 1 ? ref[1].time - ref[0].time : 0.0116;

    // Resample rec onto ref's time grid using current offset+scale.
    // For each ref frame, find the nearest rec frame whose transformed time matches.
    const recHop = rec.length > 1 ? rec[1].time - rec[0].time : 0.0116;
    const aligned: { ref: number | null; rec: number | null }[] = [];
    for (let i = 0; i < ref.length; i++) {
      const tRef = ref[i].time;
      // Inverse transform: rec_idx such that rec_idx * recHop * recScale + recOffset = tRef
      const recOriginalT = (tRef - recOffset) / recScale;
      const j = Math.round(recOriginalT / recHop);
      const recVal = j >= 0 && j < rec.length && rec[j].freq
        ? rec[j].freq! * semitoneFactor(recPitchShiftSt)
        : null;
      aligned.push({ ref: ref[i].freq, rec: recVal });
    }

    // Per-speaker stats from the original (untransformed) data
    const refVoiced = ref.filter((p) => p.freq).map((p) => p.freq!);
    const recVoicedRaw = rec.filter((p) => p.freq).map((p) => p.freq!);
    const recVoiced = recVoicedRaw.map((f) => f * semitoneFactor(recPitchShiftSt));
    const refVoicedRatio = refVoiced.length / ref.length;
    const recVoicedRatio = recVoicedRaw.length / rec.length;
    const refMeanF0 = refVoiced.length ? refVoiced.reduce((a, b) => a + b, 0) / refVoiced.length : 0;
    const recMeanF0Raw = recVoicedRaw.length ? recVoicedRaw.reduce((a, b) => a + b, 0) / recVoicedRaw.length : 0;
    const recMeanF0 = recVoiced.length ? recVoiced.reduce((a, b) => a + b, 0) / recVoiced.length : 0;

    // Pitch range in semitones = 12 * log2(maxF0 / minF0), using 5th–95th percentile
    // to avoid outliers from octave errors in YIN.
    const pct = (xs: number[], p: number) => {
      const s = [...xs].sort((a, b) => a - b);
      return s[Math.min(s.length - 1, Math.floor((p / 100) * s.length))];
    };
    const refRangeSt = refVoiced.length >= 2
      ? 12 * Math.log2(pct(refVoiced, 95) / pct(refVoiced, 5))
      : 0;
    const recRangeSt = recVoiced.length >= 2
      ? 12 * Math.log2(pct(recVoiced, 95) / pct(recVoiced, 5))
      : 0;

    // Overlap stats — only frames where BOTH are voiced
    const overlap = aligned.filter((a) => a.ref != null && a.rec != null) as { ref: number; rec: number }[];
    if (overlap.length < 5) {
      return {
        correlation: 0,
        directionAgreement: 0,
        rmsSemitones: 0,
        refRangeSt,
        recRangeSt,
        refMeanF0,
        recMeanF0,
        recMeanF0Raw,
        refVoicedRatio,
        recVoicedRatio,
        overlapFrames: overlap.length,
      };
    }

    const refLog = overlap.map((p) => Math.log(p.ref));
    const recLog = overlap.map((p) => Math.log(p.rec));
    const refMu = refLog.reduce((a, b) => a + b, 0) / refLog.length;
    const recMu = recLog.reduce((a, b) => a + b, 0) / recLog.length;

    let num = 0;
    let denR = 0;
    let denC = 0;
    for (let i = 0; i < overlap.length; i++) {
      const dr = refLog[i] - refMu;
      const dc = recLog[i] - recMu;
      num += dr * dc;
      denR += dr * dr;
      denC += dc * dc;
    }
    const correlation = denR > 0 && denC > 0 ? num / Math.sqrt(denR * denC) : 0;

    // Direction agreement: sign of frame-to-frame derivative
    let agree = 0;
    let total = 0;
    for (let i = 1; i < overlap.length; i++) {
      const dr = Math.sign(refLog[i] - refLog[i - 1]);
      const dc = Math.sign(recLog[i] - recLog[i - 1]);
      if (dr === 0 || dc === 0) continue;
      total++;
      if (dr === dc) agree++;
    }
    const directionAgreement = total > 0 ? agree / total : 0;

    // RMS distance after centering each by its mean (so registre absolu doesn't matter),
    // converted to semitones (12/ln(2)).
    let sumSq = 0;
    for (let i = 0; i < overlap.length; i++) {
      const d = (refLog[i] - refMu) - (recLog[i] - recMu);
      sumSq += d * d;
    }
    const rmsSemitones = Math.sqrt(sumSq / overlap.length) * (12 / Math.LN2);

    return {
      correlation,
      directionAgreement,
      rmsSemitones,
      refRangeSt,
      recRangeSt,
      refMeanF0,
      recMeanF0,
      recMeanF0Raw,
      refVoicedRatio,
      recVoicedRatio,
      overlapFrames: overlap.length,
    };
  }

  function renderAnalysis() {
    const panel = document.getElementById('analysis')!;
    const a = pitchAnalysis();
    if (!a) {
      panel.classList.add('hidden');
      return;
    }
    panel.classList.remove('hidden');

    const set = (id: string, val: string, tagId?: string, tag?: { text: string; cls: string }) => {
      document.getElementById(id)!.textContent = val;
      if (tagId) {
        const el = document.getElementById(tagId)!;
        el.className = 'metric-tag' + (tag ? ' ' + tag.cls : '');
        el.textContent = tag?.text ?? '';
      }
    };

    if (a.overlapFrames < 5) {
      set('m-corr', '—', 'm-corr-tag', { text: 'pas assez de chevauchement', cls: 'warn' });
      set('m-dir', '—', 'm-dir-tag', { text: '', cls: 'muted-tag' });
      set('m-rms', '—', 'm-rms-tag', { text: '', cls: 'muted-tag' });
    } else {
      const corrTag =
        a.correlation > 0.7 ? { text: 'forte', cls: 'good' } :
        a.correlation > 0.4 ? { text: 'moyenne', cls: 'warn' } :
        a.correlation > 0.1 ? { text: 'faible', cls: 'bad' } :
                              { text: 'décorrélée', cls: 'bad' };
      set('m-corr', a.correlation.toFixed(2), 'm-corr-tag', corrTag);

      const dirPct = Math.round(a.directionAgreement * 100);
      const dirTag =
        dirPct > 75 ? { text: 'bon suivi', cls: 'good' } :
        dirPct > 55 ? { text: 'partiel', cls: 'warn' } :
                      { text: 'inversé', cls: 'bad' };
      set('m-dir', `${dirPct}%`, 'm-dir-tag', dirTag);

      const rmsTag =
        a.rmsSemitones < 1.5 ? { text: 'proche', cls: 'good' } :
        a.rmsSemitones < 3.0 ? { text: 'écart modéré', cls: 'warn' } :
                               { text: 'écart fort', cls: 'bad' };
      set('m-rms', `${a.rmsSemitones.toFixed(1)} st`, 'm-rms-tag', rmsTag);
    }

    const rangeRatio = a.refRangeSt > 0 ? a.recRangeSt / a.refRangeSt : 0;
    const rangeTag =
      rangeRatio === 0 ? { text: '', cls: 'muted-tag' } :
      rangeRatio < 0.6 ? { text: '×' + rangeRatio.toFixed(2) + ' — trop plat', cls: 'bad' } :
      rangeRatio < 0.85 ? { text: '×' + rangeRatio.toFixed(2) + ' — un peu plat', cls: 'warn' } :
      rangeRatio <= 1.25 ? { text: '×' + rangeRatio.toFixed(2) + ' — équilibré', cls: 'good' } :
      rangeRatio <= 1.6 ? { text: '×' + rangeRatio.toFixed(2) + ' — un peu exagéré', cls: 'warn' } :
                          { text: '×' + rangeRatio.toFixed(2) + ' — exagéré', cls: 'bad' };
    set('m-range', `ref ${a.refRangeSt.toFixed(1)} st · toi ${a.recRangeSt.toFixed(1)} st`, 'm-range-tag', rangeTag);

    const f0Text = Math.abs(recPitchShiftSt) >= 0.05
      ? `ref ${Math.round(a.refMeanF0)} Hz · toi ${Math.round(a.recMeanF0Raw)} Hz → ${Math.round(a.recMeanF0)} Hz`
      : `ref ${Math.round(a.refMeanF0)} Hz · toi ${Math.round(a.recMeanF0)} Hz`;
    set('m-f0', f0Text);

    const refVp = Math.round(a.refVoicedRatio * 100);
    const recVp = Math.round(a.recVoicedRatio * 100);
    const voicingDiff = Math.abs(refVp - recVp);
    const voicingTag =
      voicingDiff < 10 ? { text: 'similaire', cls: 'good' } :
      voicingDiff < 25 ? { text: 'un peu différent', cls: 'warn' } :
                         { text: 'très différent', cls: 'bad' };
    set('m-voicing', `ref ${refVp}% · toi ${recVp}%`, 'm-voicing-tag', voicingTag);

    // Verdict — combine the most actionable signals
    const verdict = document.getElementById('verdict')!;
    const bits: string[] = [];
    if (a.overlapFrames < 5) {
      bits.push('Pas assez de zones voicées en commun pour analyser — vérifie l\'alignement.');
    } else {
      if (a.correlation > 0.7) bits.push('Le contour mélodique suit bien la référence.');
      else if (a.correlation > 0.4) bits.push('Le contour mélodique est globalement proche, avec quelques écarts.');
      else if (a.correlation > 0.1) bits.push('Le contour est faiblement corrélé — vérifie l\'alignement (offset/tempo) avant de juger.');
      else bits.push('Le contour est décorrélé : intonation très différente, ou alignement incorrect.');

      if (rangeRatio > 0 && rangeRatio < 0.6) bits.push('Ton intonation est nettement plus plate que la référence — accentue les montées/descentes.');
      else if (rangeRatio > 1.6) bits.push('Tu exagères les variations de pitch par rapport à la référence.');

      if (a.directionAgreement < 0.55 && a.correlation > 0.1) bits.push('Beaucoup de montées/descentes vont dans la mauvaise direction — concentre-toi sur la direction du pitch accent.');

      if (a.rmsSemitones > 3 && a.correlation > 0.5) bits.push('Forme proche mais écart notable même registre normalisé — sans doute des moments précis qui décrochent.');
    }
    verdict.textContent = bits.join(' ');
  }

  document.getElementById('compare-btn')!.addEventListener('click', () => {
    comparedOnce = true;
    redrawCompare();
    scaleSlider.disabled = false;
    pitchShiftSlider.disabled = false;
    waveformOverlayToggle.disabled = false;
    resetBtn.disabled = false;
    autoBtn.disabled = false;
  });

  scaleSlider.addEventListener('input', () => {
    recScale = parseFloat(scaleSlider.value);
    redrawCompare();
  });

  pitchShiftSlider.addEventListener('input', () => {
    recPitchShiftSt = parseFloat(pitchShiftSlider.value);
    redrawCompare();
  });

  waveformOverlayToggle.addEventListener('change', () => {
    showWaveformOverlay = waveformOverlayToggle.checked;
    redrawCompare();
  });

  resetBtn.addEventListener('click', () => {
    recOffset = 0;
    recScale = 1;
    recPitchShiftSt = 0;
    scaleSlider.value = '1';
    pitchShiftSlider.value = '0';
    redrawCompare();
  });

  // Drag on the compare canvas:
  // - horizontal movement adjusts timing offset
  // - vertical movement adjusts rec pitch in semitones
  let dragState: {
    startX: number;
    startY: number;
    startOffset: number;
    startPitchShiftSt: number;
    tMax: number;
    w: number;
    padX: number;
    usableH: number;
    pitchRangeSt: number;
  } | null = null;

  compareCanvas.addEventListener('pointerdown', (e) => {
    if (!comparedOnce || !lastCompareLayout) return;
    compareCanvas.setPointerCapture(e.pointerId);
    compareCanvas.classList.add('dragging');
    dragState = {
      startX: e.clientX,
      startY: e.clientY,
      startOffset: recOffset,
      startPitchShiftSt: recPitchShiftSt,
      tMax: lastCompareLayout.tMax,
      w: lastCompareLayout.w,
      padX: lastCompareLayout.padX,
      usableH: lastCompareLayout.usableH,
      pitchRangeSt: lastCompareLayout.pitchRangeSt,
    };
  });

  compareCanvas.addEventListener('pointermove', (e) => {
    if (!dragState) return;
    const pixelsPerSec = (dragState.w - dragState.padX) / dragState.tMax;
    const pixelsPerSemitone = dragState.usableH / dragState.pitchRangeSt;
    recOffset = dragState.startOffset + (e.clientX - dragState.startX) / pixelsPerSec;
    recPitchShiftSt = clamp(
      dragState.startPitchShiftSt - (e.clientY - dragState.startY) / pixelsPerSemitone,
      Number(pitchShiftSlider.min),
      Number(pitchShiftSlider.max),
    );
    redrawCompare();
  });

  function endDrag(e: PointerEvent) {
    if (!dragState) return;
    compareCanvas.releasePointerCapture(e.pointerId);
    compareCanvas.classList.remove('dragging');
    dragState = null;
  }
  compareCanvas.addEventListener('pointerup', endDrag);
  compareCanvas.addEventListener('pointercancel', endDrag);

  // Auto-align: maximize contour similarity over the current tempo, then estimate
  // the vertical pitch shift in semitones from the matched voiced frames.
  autoBtn.addEventListener('click', () => {
    const ref = slots.ref.pitch;
    const rec = slots.rec.pitch;
    if (!ref.length || !rec.length) return;

    const refDuration = ref[ref.length - 1]?.time ?? 0;
    const recDuration = (rec[rec.length - 1]?.time ?? 0) * recScale;
    const searchRange = Math.min(6, Math.max(2, Math.max(refDuration, recDuration) * 0.8));

    const coarse = findBestOffset(searchRange, 0.025, 0);
    const refined = findBestOffset(0.22, 0.005, coarse.offset);
    const best = Number.isFinite(refined.score) && refined.score >= coarse.score ? refined : coarse;

    if (Number.isFinite(best.offset)) {
      recOffset = best.offset;
      const estimatedShift = estimatePitchShiftSt(recOffset);
      if (estimatedShift != null) {
        recPitchShiftSt = clamp(estimatedShift, Number(pitchShiftSlider.min), Number(pitchShiftSlider.max));
      }
      redrawCompare();
    }
  });

  function findBestOffset(range: number, stepSec: number, center: number): { offset: number; score: number } {
    let bestOffset = center;
    let bestScore = -Infinity;
    for (let off = center - range; off <= center + range; off += stepSec) {
      const score = alignmentScore(off);
      if (score > bestScore) {
        bestScore = score;
        bestOffset = off;
      }
    }
    return { offset: bestOffset, score: bestScore };
  }

  function samplePitchAt(points: PitchPoint[], t: number, maxGapSec = 0.06): number | null {
    if (!points.length || t < points[0].time || t > points[points.length - 1].time) return null;

    let lo = 0;
    let hi = points.length - 1;
    while (lo <= hi) {
      const mid = (lo + hi) >> 1;
      if (points[mid].time < t) lo = mid + 1;
      else hi = mid - 1;
    }

    const right = clamp(lo, 0, points.length - 1);
    const left = clamp(right - 1, 0, points.length - 1);
    const leftPoint = points[left];
    const rightPoint = points[right];

    if (leftPoint.freq == null && rightPoint.freq == null) return null;
    if (leftPoint.freq != null && rightPoint.freq != null) {
      const gap = Math.abs(rightPoint.time - leftPoint.time);
      if (gap > maxGapSec) return null;
      if (gap <= 1e-6) return leftPoint.freq;
      const alpha = clamp((t - leftPoint.time) / gap, 0, 1);
      return Math.exp(Math.log(leftPoint.freq) + alpha * (Math.log(rightPoint.freq) - Math.log(leftPoint.freq)));
    }

    const candidate = leftPoint.freq != null ? leftPoint : rightPoint;
    return Math.abs(candidate.time - t) <= maxGapSec ? candidate.freq! : null;
  }

  function alignedLogPairs(offset: number, pitchShiftSt = 0): { ref: number; rec: number }[] {
    const pairs: { ref: number; rec: number }[] = [];
    for (const refPoint of slots.ref.pitch) {
      if (refPoint.freq == null) continue;
      const recOriginalT = (refPoint.time - offset) / recScale;
      const recFreq = samplePitchAt(slots.rec.pitch, recOriginalT);
      if (recFreq == null) continue;
      pairs.push({
        ref: Math.log(refPoint.freq),
        rec: Math.log(recFreq * semitoneFactor(pitchShiftSt)),
      });
    }
    return pairs;
  }

  function pearson(xs: number[], ys: number[]): number | null {
    if (xs.length !== ys.length || xs.length < 3) return null;
    let sx = 0;
    let sy = 0;
    let sx2 = 0;
    let sy2 = 0;
    let sxy = 0;
    for (let i = 0; i < xs.length; i++) {
      const x = xs[i];
      const y = ys[i];
      sx += x;
      sy += y;
      sx2 += x * x;
      sy2 += y * y;
      sxy += x * y;
    }
    const n = xs.length;
    const cov = n * sxy - sx * sy;
    const denX = n * sx2 - sx * sx;
    const denY = n * sy2 - sy * sy;
    if (denX <= 0 || denY <= 0) return null;
    return cov / Math.sqrt(denX * denY);
  }

  function alignmentScore(offset: number): number {
    const pairs = alignedLogPairs(offset, 0);
    if (pairs.length < 10) return -Infinity;

    const ref = pairs.map((p) => p.ref);
    const rec = pairs.map((p) => p.rec);
    const contourCorr = pearson(ref, rec);
    if (contourCorr == null) return -Infinity;

    const dRef: number[] = [];
    const dRec: number[] = [];
    for (let i = 1; i < pairs.length; i++) {
      dRef.push(pairs[i].ref - pairs[i - 1].ref);
      dRec.push(pairs[i].rec - pairs[i - 1].rec);
    }
    const derivativeCorr = pearson(dRef, dRec) ?? 0;

    // Favor offsets with enough overlap, but do not let overlap alone dominate.
    const overlapWeight = Math.min(1, pairs.length / 45);
    return (0.78 * contourCorr + 0.22 * derivativeCorr) * overlapWeight;
  }

  function estimatePitchShiftSt(offset: number): number | null {
    const pairs = alignedLogPairs(offset, 0);
    if (pairs.length < 8) return null;
    const diffs = pairs.map((p) => 12 * (p.ref - p.rec) / Math.LN2);
    return median(diffs);
  }

  function mean(xs: (number | null)[]): number {
    let s = 0;
    let n = 0;
    for (const x of xs) {
      if (x != null) {
        s += x;
        n++;
      }
    }
    return n ? s / n : 0;
  }

  // Redraw on resize so canvases stay sharp
  window.addEventListener('resize', () => {
    if (slots.ref.pitch.length) {
      drawPitchCurve(document.getElementById('ref-pitch') as HTMLCanvasElement, [
        { points: slots.ref.pitch, color: colors.ref },
      ]);
    }
    if (slots.rec.pitch.length) {
      drawPitchCurve(document.getElementById('rec-pitch') as HTMLCanvasElement, [
        { points: slots.rec.pitch, color: colors.rec },
      ]);
    }
    redrawCompare();
  });

  // ─── Lesson loading + auto XML lookup ───
  // Uses ../scripts/shadow-library.ts. The XML lessons folder is set up once
  // via /settings; here we just pick a single audio lesson folder and look up
  // its matching <lesson>.xml in the saved xmlDir handle.

  const libState: {
    xmlDir: FileSystemDirectoryHandle | null;
    xmlFilenameTemplate: string;
  } = { xmlDir: null, xmlFilenameTemplate: '{lesson}.xml' };

  // Refresh in-memory xmlDir state from the saved handle. If `requestIfPrompt`
  // is true, will actively prompt for permission when needed (must be called
  // inside a user gesture).
  async function refreshXmlDirState(opts: { requestIfPrompt?: boolean } = {}) {
    libState.xmlFilenameTemplate = ShadowLib.getConfig().xmlFilenameTemplate;
    if (!ShadowLib.isFsApiSupported()) {
      libState.xmlDir = null;
      return;
    }
    const h = await ShadowLib.loadXmlDirHandle();
    if (!h) {
      libState.xmlDir = null;
      return;
    }
    let perm = await (h as any).queryPermission({ mode: 'read' });
    if (perm !== 'granted' && opts.requestIfPrompt) {
      perm = await (h as any).requestPermission({ mode: 'read' });
    }
    libState.xmlDir = perm === 'granted' ? h : null;
  }

  // Per-lesson state — populated when a lesson is picked. Used to render the
  // sequential phrases list and to look up files by their bare name (e.g. S01.mp3)
  // when matching against XML <tt audio="..."> attributes.
  const lessonState: {
    lessonId: string;
    files: File[];
    filesByName: Map<string, File>;
    phrases: PhraseData[];
  } = { lessonId: '', files: [], filesByName: new Map(), phrases: [] };

  // Activate a picked lesson handle: walk audio, populate tree, update status,
  // eagerly load + render the lesson XML phrases list.
  async function activateLesson(lessonHandle: FileSystemDirectoryHandle, opts: { quiet?: boolean } = {}) {
    const audioFiles = await ShadowLib.walkFiles(lessonHandle, AUDIO_EXT_RE);
    if (!audioFiles.length) {
      if (!opts.quiet) alert('Aucun fichier audio dans ce dossier.');
      return false;
    }
    // Reset state from previous lesson
    phraseMap.clear();
    document.getElementById('ref-phrase')!.classList.add('hidden');
    document.getElementById('ref-phrases-list')!.classList.add('hidden');

    lessonState.lessonId = lessonHandle.name;
    lessonState.files = audioFiles;
    lessonState.filesByName = new Map(audioFiles.map((f) => [f.name, f]));
    lessonState.phrases = [];

    loadAudioFolderFromFiles(audioFiles, lessonHandle.name);
    // We're inside a user gesture (the click that opened the picker), so we can
    // request xmlDir permission too without an extra confirmation.
    await refreshXmlDirState({ requestIfPrompt: true });
    await loadAndRenderLessonPhrases();
    updateLessonStatus(lessonHandle.name);
    return true;
  }

  // Load the lesson's XML upfront and render the list of all its phrases.
  async function loadAndRenderLessonPhrases() {
    if (!libState.xmlDir || !lessonState.lessonId) return;
    const xmlText = await ShadowLib.readXmlByLessonId(
      libState.xmlDir,
      lessonState.lessonId,
      libState.xmlFilenameTemplate,
    );
    if (!xmlText) return;
    const phrases = parseLessonXml(xmlText);
    lessonState.phrases = phrases;
    for (const p of phrases) phraseMap.set(`${p.lessonId}/${p.audioFile}`, p);
    renderPhrasesList();
    setReferenceTab('phrases');
  }

  function renderPhrasesList() {
    const panel = document.getElementById('ref-phrases-list')!;
    const title = document.getElementById('phrases-list-title')!;
    const count = document.getElementById('phrases-list-count')!;
    const body = document.getElementById('phrases-list-body')!;
    if (!lessonState.phrases.length) {
      panel.classList.add('hidden');
      return;
    }
    panel.classList.remove('hidden');
    title.textContent = `Leçon ${lessonState.lessonId}`;
    const withAudio = lessonState.phrases.filter((p) => lessonState.filesByName.has(p.audioFile)).length;
    count.textContent = withAudio === lessonState.phrases.length
      ? `${lessonState.phrases.length} phrases`
      : `${withAudio} / ${lessonState.phrases.length} phrases (audio dispo)`;
    body.innerHTML = '';

    for (const p of lessonState.phrases) {
      const file = lessonState.filesByName.get(p.audioFile);
      const isActive = !!(file && folderState.activeName === file.webkitRelativePath);

      const row = document.createElement('div');
      row.className = 'phrase-row' + (file ? '' : ' no-audio') + (isActive ? ' active' : '');

      // Build meta rows only when there's content
      const metaRows: string[] = [];
      if (p.ph) {
        metaRows.push(`<span class="meta-label">Romaji</span><span class="meta-value">${escapeText(p.ph)}</span>`);
      }
      if (p.trlat) {
        metaRows.push(`<span class="meta-label">Français</span><span class="meta-value">${escapeText(p.trlat)}</span>`);
      }
      if (!file) {
        metaRows.push(`<span class="meta-label">Audio</span><span class="meta-value"><span class="phrase-row-missing">${escapeText(p.audioFile)} introuvable</span></span>`);
      }

      row.innerHTML = `
        ${isActive ? '<span class="phrase-row-playing">playing</span>' : ''}
        <span class="phrase-row-badge"></span>
        <div class="phrase-row-content">
          <div class="phrase-row-jp"></div>
          ${metaRows.length ? `<div class="phrase-row-meta">${metaRows.join('')}</div>` : ''}
        </div>
      `;
      (row.querySelector('.phrase-row-badge') as HTMLElement).textContent = p.num || '·';
      (row.querySelector('.phrase-row-jp') as HTMLElement).innerHTML = p.jpHtml;

      if (file) {
        row.addEventListener('click', async () => {
          folderState.activeName = file.webkitRelativePath;
          lastSelectedSlot = 'ref';
          renderTree();
          renderPhrasesList();
          renderPhrasePanel(p);
          await loadIntoSlot('ref', file, { autoplay: true });
        });
      }
      body.appendChild(row);
    }
  }

  function escapeText(s: string): string {
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  async function updateLessonStatus(lessonName: string) {
    const status = document.getElementById('xml-status')!;
    status.classList.remove('hidden');
    const audioCount = lessonState.files.length;
    const cfgLink = `<a href="${(import.meta as any).env.BASE_URL || ''}/settings">/settings</a>`;
    const savedXml = ShadowLib.isFsApiSupported() ? await ShadowLib.loadXmlDirHandle() : null;

    if (!savedXml) {
      status.innerHTML = `<span style="color: var(--gold);">⚠</span> Leçon <strong>${lessonName}</strong> · ${audioCount} audio${audioCount > 1 ? 's' : ''} — pas de dossier XML configuré (voir ${cfgLink})`;
      return;
    }
    if (!libState.xmlDir) {
      status.innerHTML = `<span style="color: var(--gold);">⚠</span> Leçon <strong>${lessonName}</strong> · permission XML refusée <button id="xml-grant" class="btn small" style="margin-left:0.5rem;">Réessayer</button>`;
      document.getElementById('xml-grant')?.addEventListener('click', async () => {
        await refreshXmlDirState({ requestIfPrompt: true });
        await loadAndRenderLessonPhrases();
        await updateLessonStatus(lessonName);
      });
      return;
    }
    if (lessonState.phrases.length === 0) {
      const expectedFile = libState.xmlFilenameTemplate.replace('{lesson}', lessonName);
      status.innerHTML = `<span style="color: var(--gold);">⚠</span> Leçon <strong>${lessonName}</strong> · ${audioCount} audio${audioCount > 1 ? 's' : ''} — <code>${expectedFile}</code> introuvable dans <strong>${libState.xmlDir.name}/</strong>`;
      return;
    }
    status.innerHTML = `<span class="ok">✓</span> Leçon <strong>${lessonName}</strong> · ${audioCount} audios · ${lessonState.phrases.length} phrases (XML : <strong>${libState.xmlDir.name}/</strong>)`;
  }

  // 📁 Lesson button
  if (ShadowLib.isFsApiSupported()) {
    document.getElementById('ref-library')!.addEventListener('click', async () => {
      try {
        const h = await ShadowLib.pickLessonHandle();
        await activateLesson(h);
      } catch (e: any) {
        if (e?.name !== 'AbortError') alert(`Erreur : ${e?.message ?? e}`);
      }
    });
    (document.querySelector('label.fallback-only') as HTMLElement | null)?.remove();
  } else {
    // Safari / Firefox fallback: webkitdirectory on the lesson folder.
    // No XML auto-lookup (no persistent handle to the XML dir).
    document.getElementById('ref-library')!.addEventListener('click', () => {
      (document.getElementById('ref-folder') as HTMLInputElement).click();
    });
    document.getElementById('ref-folder')!.addEventListener('change', (e) => {
      const all = Array.from((e.target as HTMLInputElement).files || []);
      const audio = all.filter((f) => AUDIO_EXT_RE.test(f.name));
      if (!audio.length) {
        alert('Aucun audio dans ce dossier.');
        return;
      }
      phraseMap.clear();
      document.getElementById('ref-phrase')!.classList.add('hidden');
      const rootName = audio[0].webkitRelativePath.split('/')[0];
      loadAudioFolderFromFiles(audio, rootName);
      const status = document.getElementById('xml-status')!;
      status.classList.remove('hidden');
      status.innerHTML = `<span style="color: var(--gold);">⚠</span> Leçon <strong>${rootName}</strong> · auto-XML indisponible sur ce navigateur (utilise Chrome/Edge pour la version complète)`;
    });
  }

  // Auto-restore on page load (Chromium only). Both the xmlDir and the last lesson
  // can be restored — we update the in-memory state silently if permission is still
  // granted, and show a banner if a permission re-grant is needed.
  if (ShadowLib.isFsApiSupported()) {
    (async () => {
      // Refresh xmlDir state (silent if perm still granted, null otherwise).
      await refreshXmlDirState();

      const lessonHandle = await ShadowLib.loadLastLessonHandle();
      if (!lessonHandle) return;
      const lessonPerm = await (lessonHandle as any).queryPermission({ mode: 'read' });
      const xmlNeedsGrant =
        (await ShadowLib.loadXmlDirHandle()) !== null && libState.xmlDir === null;

      if (lessonPerm === 'granted' && !xmlNeedsGrant) {
        await activateLesson(lessonHandle, { quiet: true });
        return;
      }

      // Need a user gesture for at least one permission — show banner.
      const banner = document.getElementById('defaults-banner')!;
      const text = document.getElementById('defaults-text')!;
      const actions = document.getElementById('defaults-actions')!;
      banner.classList.remove('hidden');
      const parts: string[] = [];
      if (lessonHandle) parts.push(`📁 ${lessonHandle.name}`);
      if (xmlNeedsGrant) parts.push('📄 dossier XML');
      text.textContent = `Restaurer la session précédente : ${parts.join(' · ')}`;
      actions.innerHTML = '';
      const restoreBtn = document.createElement('button');
      restoreBtn.className = 'btn small accent';
      restoreBtn.textContent = '↻ Restaurer';
      restoreBtn.addEventListener('click', async () => {
        // Re-grant XML dir first (so the lesson activation already sees it).
        if (xmlNeedsGrant) {
          const xmlH = await ShadowLib.loadXmlDirHandle();
          if (xmlH) await ShadowLib.ensurePermission(xmlH);
        }
        await refreshXmlDirState();
        const okLesson = await ShadowLib.ensurePermission(lessonHandle);
        if (!okLesson) {
          alert('Permission refusée pour la leçon.');
          return;
        }
        const loaded = await activateLesson(lessonHandle);
        if (loaded) banner.classList.add('hidden');
      });
      actions.appendChild(restoreBtn);
    })();

    document.getElementById('defaults-dismiss')!.addEventListener('click', () => {
      document.getElementById('defaults-banner')!.classList.add('hidden');
    });
  }
</script>
