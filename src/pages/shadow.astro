---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Shadow">
  <a href={import.meta.env.BASE_URL} class="back">&larr; Home</a>

  <header class="section-header">
    <span class="section-number">Spike</span>
    <h1>Shadow — pronunciation lab</h1>
    <p class="description">
      Charge un audio de référence (ou enregistre-le), puis enregistre ta voix et compare : waveform,
      spectrogramme et courbe de pitch (F0). Tout reste local au navigateur.
    </p>
  </header>

  <div id="defaults-banner" class="defaults-banner hidden">
    <span class="banner-icon">📌</span>
    <span class="banner-text" id="defaults-text"></span>
    <div class="banner-actions" id="defaults-actions"></div>
    <button id="defaults-dismiss" class="btn-icon" title="Fermer">×</button>
  </div>

  <section class="shadow-card shadow-card--reference">
    <div class="card-head reference-head">
      <h2>Référence</h2>
      <div class="card-actions">
        <label class="btn small">
          Upload audio
          <input id="ref-file" type="file" accept="audio/*" hidden />
        </label>
        <button id="ref-library" class="btn small" title="Choisir le dossier audio d'une leçon (XML auto-trouvé via /settings)">📁 Lesson</button>
        <label class="btn small fallback-only" hidden>
          📁 Lesson
          <input id="ref-folder" type="file" hidden webkitdirectory multiple />
        </label>
        <button id="ref-play" class="btn small" disabled>▶ Play</button>
        <button id="ref-loop" class="btn small loop-btn" disabled aria-pressed="false" title="Loop la sélection">↻</button>
      </div>
    </div>

    <div class="reference-grid">
      <div class="reference-list-column">
        <div id="xml-status" class="xml-status hidden"></div>

        <div class="reference-tabs" role="tablist" aria-label="Sources de référence">
          <button id="ref-tab-files" class="reference-tab active" type="button" role="tab" aria-selected="true" aria-controls="ref-tab-panel-files" data-reference-tab="files">Fichiers</button>
          <button id="ref-tab-phrases" class="reference-tab" type="button" role="tab" aria-selected="false" aria-controls="ref-tab-panel-phrases" data-reference-tab="phrases">Phrases</button>
        </div>

        <div id="ref-tab-panel-files" class="reference-tab-panel active" role="tabpanel" aria-labelledby="ref-tab-files" data-reference-tab-panel="files">
          <div id="ref-folder-panel" class="folder-panel hidden">
            <div class="folder-meta">
              <span class="folder-icon">📂</span>
              <span id="ref-folder-name" class="folder-name"></span>
              <span id="ref-folder-count" class="folder-count"></span>
              <button id="ref-folder-clear" class="btn-icon" title="Fermer le dossier">×</button>
            </div>
            <div id="ref-file-list" class="file-list"></div>
          </div>
          <div id="ref-files-empty" class="tab-empty">Charge une leçon ou un dossier audio pour afficher les fichiers.</div>
        </div>

        <div id="ref-tab-panel-phrases" class="reference-tab-panel" role="tabpanel" aria-labelledby="ref-tab-phrases" data-reference-tab-panel="phrases">
          <div id="ref-phrases-list" class="phrases-list hidden">
            <div class="phrases-list-head">
              <span class="phrases-list-title" id="phrases-list-title"></span>
              <span class="phrases-list-count" id="phrases-list-count"></span>
            </div>
            <div id="phrases-list-body"></div>
          </div>
          <div id="ref-phrases-empty" class="tab-empty">Aucune phrase indexée pour le moment.</div>
        </div>
      </div>

      <div class="reference-detail-column">
        <div id="ref-phrase" class="phrase-panel hidden">
          <div class="phrase-meta" id="phrase-meta"></div>
          <div class="phrase-jp" id="phrase-jp"></div>
          <div class="phrase-ph" id="phrase-ph"></div>
          <div class="phrase-fr" id="phrase-fr"></div>
        </div>
        <div id="ref-wave" class="wave"></div>
        <canvas id="ref-pitch" class="pitch-canvas" height="120"></canvas>
        <div id="ref-status" class="status muted small">Pas de fichier chargé. <span class="hint-inline">Astuce : glisse pour sélectionner une portion à looper. Espace lance/met en pause le dernier audio sélectionné.</span></div>
        <section class="reference-subcard reference-subcard--recording">
          <div class="card-head">
            <h2>Ta voix</h2>
            <div class="card-actions">
              <button id="rec-start" class="btn small accent">🎙 Record</button>
              <button id="rec-stop" class="btn small" disabled>■ Stop</button>
              <button id="rec-play" class="btn small" disabled>▶ Play</button>
              <button id="rec-loop" class="btn small loop-btn" disabled aria-pressed="false" title="Loop la sélection">↻</button>
            </div>
          </div>
          <div id="rec-wave" class="wave"></div>
          <canvas id="rec-pitch" class="pitch-canvas" height="120"></canvas>
          <div id="rec-status" class="status muted small">Clique "Record" pour commencer.</div>
        </section>

        <section class="reference-subcard reference-subcard--compare">
          <div class="card-head">
            <h2>Comparaison pitch</h2>
            <div class="card-actions">
              <button id="compare-btn" class="btn small" disabled>Superposer les 2 courbes</button>
              <button id="auto-align-btn" class="btn small" disabled title="Cross-corrélation des pitches">Auto-align</button>
              <button id="reset-align-btn" class="btn small" disabled>Reset</button>
            </div>
          </div>
          <canvas id="compare-pitch" class="pitch-canvas tall" height="220"></canvas>
          <div class="align-controls">
            <label class="align-row">
              <span>Tempo (×<span id="scale-val">1.00</span>)</span>
              <input id="scale-slider" type="range" min="0.5" max="2.0" step="0.01" value="1" disabled />
            </label>
            <label class="align-row">
              <span>Pitch (<span id="pitch-shift-val">+0.0</span> st)</span>
              <input id="pitch-shift-slider" type="range" min="-24" max="24" step="0.1" value="0" disabled />
            </label>
            <label class="compare-toggle" title="Affiche les enveloppes waveform de la référence et de ta voix sur le graphe de comparaison">
              <input id="show-waveform-overlay" type="checkbox" disabled />
              <span>Waveforms</span>
            </label>
            <span class="hint">Glisse la courbe rouge horizontalement pour caler le timing, verticalement pour ajuster le pitch. Offset : <span id="offset-val">0.00</span>s</span>
          </div>
          <div class="legend">
            <span><i class="dot ref"></i> Référence</span>
            <span><i class="dot rec"></i> Ta voix (déplaçable)</span>
          </div>

          <div id="analysis" class="analysis hidden">
            <h3>Analyse</h3>
            <div class="metrics-grid">
              <div class="metric">
                <span class="metric-label">Corrélation contour</span>
                <span class="metric-value" id="m-corr">—</span>
                <span class="metric-tag" id="m-corr-tag"></span>
              </div>
              <div class="metric">
                <span class="metric-label">Direction (montée/descente)</span>
                <span class="metric-value" id="m-dir">—</span>
                <span class="metric-tag" id="m-dir-tag"></span>
              </div>
              <div class="metric">
                <span class="metric-label">Écart RMS (registre normalisé)</span>
                <span class="metric-value" id="m-rms">—</span>
                <span class="metric-tag" id="m-rms-tag"></span>
              </div>
              <div class="metric">
                <span class="metric-label">Plage de pitch</span>
                <span class="metric-value" id="m-range">—</span>
                <span class="metric-tag" id="m-range-tag"></span>
              </div>
              <div class="metric">
                <span class="metric-label">F0 moyen</span>
                <span class="metric-value" id="m-f0">—</span>
                <span class="metric-tag muted-tag">informatif</span>
              </div>
              <div class="metric">
                <span class="metric-label">Voicing</span>
                <span class="metric-value" id="m-voicing">—</span>
                <span class="metric-tag" id="m-voicing-tag"></span>
              </div>
            </div>
            <div class="verdict" id="verdict"></div>
          </div>
        </section>
      </div>
    </div>
  </section>

  <div id="countdown-overlay" class="countdown-overlay hidden" aria-hidden="true">
    <div class="countdown-num" id="countdown-num">3</div>
  </div>

  <style>
    :root {
      --shadow-waveform-height: 80px;
      --shadow-spectrogram-height: 180px;
      --shadow-audio-display-height: calc(
        var(--shadow-waveform-height) + var(--shadow-spectrogram-height)
      );
    }

    .back {
      display: inline-block;
      margin-bottom: 1rem;
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.85rem;
    }
    .back:hover { color: var(--accent); }

    .section-header { margin-bottom: 2rem; }
    .section-number {
      display: inline-block;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 0.4rem;
    }
    .section-header h1 {
      font-size: 1.85rem;
      font-weight: 800;
      letter-spacing: -0.025em;
      color: var(--text-strong);
      margin-bottom: 0.6rem;
    }
    .description {
      color: var(--text-muted);
      max-width: 60ch;
      line-height: 1.55;
    }

    .shadow-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 1.25rem 1.4rem 1.4rem;
      margin-bottom: 1.2rem;
      box-shadow: var(--shadow-sm);
    }
    .reference-grid {
      display: block;
    }
    .reference-list-column,
    .reference-detail-column {
      min-width: 0;
    }

    .card-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 1rem;
    }
    .card-head h2 {
      font-size: 1.05rem;
      font-weight: 700;
      letter-spacing: -0.01em;
      color: var(--text-strong);
    }
    .card-actions { display: inline-flex; gap: 0.45rem; align-items: center; }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.45rem 0.85rem;
      background: var(--bg-input);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--text);
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
      transition: border-color var(--dur-fast) var(--ease),
                  background var(--dur-fast) var(--ease),
                  color var(--dur-fast) var(--ease);
    }
    .btn:hover:not(:disabled) {
      border-color: var(--accent);
      color: var(--accent);
    }
    .btn:disabled { opacity: 0.45; cursor: not-allowed; }
    .btn.small { font-size: 0.78rem; padding: 0.4rem 0.75rem; }
    .btn.accent {
      background: var(--accent);
      border-color: var(--accent);
      color: white;
    }
    .btn.accent:hover:not(:disabled) {
      background: var(--accent-hover);
      border-color: var(--accent-hover);
      color: white;
    }

    .wave {
      position: relative;
      width: 100%;
      height: var(--shadow-audio-display-height);
      min-height: var(--shadow-audio-display-height);
      background: var(--bg-input);
      border-radius: 8px;
      overflow: hidden;
    }

    .pitch-canvas {
      display: block;
      width: 100%;
      height: 120px;
      margin-top: 0.6rem;
      background: var(--bg-input);
      border-radius: 8px;
    }
    .pitch-canvas.tall { height: 220px; }

    .status {
      margin-top: 0.6rem;
      font-size: 0.78rem;
      color: var(--text-muted);
    }

    .legend {
      display: flex;
      gap: 1.2rem;
      margin-top: 0.6rem;
      font-size: 0.78rem;
      color: var(--text-muted);
    }
    .legend .dot {
      display: inline-block;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      margin-right: 0.35rem;
      vertical-align: middle;
    }
    .legend .dot.ref { background: #4a8eb5; }
    .legend .dot.rec { background: var(--accent); }

    .align-controls {
      display: flex;
      gap: 1.2rem;
      align-items: center;
      margin-top: 0.7rem;
      flex-wrap: wrap;
    }
    .align-row {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      font-size: 0.78rem;
      color: var(--text-muted);
    }
    .align-row input[type="range"] {
      width: 180px;
      accent-color: var(--accent);
    }
    #pitch-shift-slider { accent-color: var(--gold); }
    .align-row input[type="range"]:disabled { opacity: 0.4; }
    .compare-toggle {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.38rem 0.65rem;
      background: var(--bg-input);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--text-muted);
      font-size: 0.78rem;
      font-weight: 700;
      cursor: pointer;
      user-select: none;
      transition: border-color var(--dur-fast) var(--ease),
                  color var(--dur-fast) var(--ease),
                  background var(--dur-fast) var(--ease);
    }
    .compare-toggle:hover {
      border-color: var(--accent);
      color: var(--accent);
    }
    .compare-toggle input {
      margin: 0;
      accent-color: var(--accent);
    }
    .compare-toggle:has(input:checked) {
      background: color-mix(in srgb, var(--accent) 14%, var(--bg-input));
      border-color: var(--accent);
      color: var(--accent);
    }
    .compare-toggle:has(input:disabled) {
      opacity: 0.45;
      cursor: not-allowed;
    }
    .align-controls .hint {
      font-size: 0.78rem;
      color: var(--text-subtle);
    }
    #compare-pitch { cursor: grab; touch-action: none; }
    #compare-pitch.dragging { cursor: grabbing; }

    .analysis {
      margin-top: 1.2rem;
      padding-top: 1rem;
      border-top: 1px solid var(--border);
    }
    .analysis.hidden { display: none; }
    .analysis h3 {
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: 0.7rem;
    }
    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 0.7rem;
    }
    .metric {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
      padding: 0.65rem 0.8rem;
      background: var(--bg-input);
      border: 1px solid var(--border);
      border-radius: 8px;
    }
    .metric-label {
      font-size: 0.72rem;
      color: var(--text-muted);
      letter-spacing: 0.02em;
    }
    .metric-value {
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--text-strong);
      font-variant-numeric: tabular-nums;
    }
    .metric-tag {
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.04em;
    }
    .metric-tag.good     { color: var(--success); }
    .metric-tag.warn     { color: var(--gold); }
    .metric-tag.bad      { color: var(--error); }
    .metric-tag.muted-tag{ color: var(--text-subtle); }

    .verdict {
      margin-top: 0.85rem;
      padding: 0.7rem 0.9rem;
      background: var(--accent-soft);
      border-left: 3px solid var(--accent);
      border-radius: 6px;
      font-size: 0.88rem;
      color: var(--text);
      line-height: 1.55;
    }

    .countdown-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.55);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1000;
      pointer-events: none;
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }
    .countdown-overlay.hidden { display: none; }
    .countdown-num {
      font-size: 14rem;
      font-weight: 800;
      color: white;
      letter-spacing: -0.04em;
      text-shadow: 0 8px 40px rgba(0, 0, 0, 0.55);
      font-variant-numeric: tabular-nums;
      line-height: 1;
    }
    .countdown-num.go {
      color: #ffffff;
      font-size: 9rem;
      letter-spacing: 0.04em;
      text-shadow: 0 0 40px var(--accent), 0 8px 40px rgba(0, 0, 0, 0.55);
    }
    .countdown-num.rec {
      color: var(--accent);
      font-size: 7rem;
    }

    .folder-panel {
      margin-bottom: 0.9rem;
      background: var(--bg-input);
      border: 1px solid var(--border);
      border-radius: 8px;
      overflow: hidden;
    }
    .folder-panel.hidden { display: none; }
    .folder-meta {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 0.7rem;
      border-bottom: 1px solid var(--border);
      background: var(--bg-elevated);
      font-size: 0.78rem;
    }
    .folder-icon { opacity: 0.8; }
    .folder-name {
      font-weight: 600;
      color: var(--text-strong);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      flex-shrink: 1;
      min-width: 0;
    }
    .folder-count {
      color: var(--text-muted);
      font-size: 0.72rem;
      flex: 1;
    }
    .btn-icon {
      background: transparent;
      border: none;
      color: var(--text-muted);
      width: 24px;
      height: 24px;
      border-radius: 6px;
      cursor: pointer;
      font-size: 1.1rem;
      line-height: 1;
      transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
    }
    .btn-icon:hover { background: var(--bg-muted); color: var(--accent); }

    .file-list {
      max-height: 280px;
      overflow-y: auto;
      padding: 0.25rem 0;
    }

    .loop-btn {
      color: var(--text-muted);
    }
    .loop-btn.active {
      background: color-mix(in srgb, var(--gold) 18%, var(--bg-input));
      border-color: var(--gold);
      color: var(--gold);
    }
    .loop-btn.active:hover {
      background: color-mix(in srgb, var(--gold) 26%, var(--bg-input));
      border-color: var(--gold);
      color: var(--gold);
    }

    .hint-inline {
      color: var(--text-subtle);
      font-style: italic;
    }

    .xml-status {
      margin-bottom: 0.7rem;
      padding: 0.4rem 0.7rem;
      background: var(--bg-input);
      border: 1px solid var(--border);
      border-radius: 6px;
      font-size: 0.74rem;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .xml-status.hidden { display: none; }
    .xml-status .ok { color: var(--success); font-weight: 600; }

    .phrase-panel {
      margin-bottom: 0.9rem;
      padding: 0.85rem 1rem;
      background: linear-gradient(180deg, var(--bg-input) 0%, var(--bg-card) 100%);
      border: 1px solid var(--border);
      border-left: 3px solid var(--accent);
      border-radius: 8px;
    }
    .phrase-panel.hidden { display: none; }
    .phrase-meta {
      font-size: 0.7rem;
      color: var(--text-subtle);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      margin-bottom: 0.5rem;
      font-weight: 600;
    }
    .phrase-jp {
      font-family: 'Noto Sans JP', sans-serif;
      font-size: 1.35rem;
      line-height: 1.9;
      color: var(--text-strong);
      margin-bottom: 0.4rem;
    }
    .phrase-jp ruby rt {
      font-size: 0.55em;
      color: var(--text-muted);
    }
    .phrase-ph {
      font-style: italic;
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-bottom: 0.3rem;
    }
    .phrase-ph:empty { display: none; }
    .phrase-fr {
      font-size: 0.95rem;
      color: var(--text);
    }
    .phrase-fr:empty { display: none; }

    .phrases-list {
      margin-bottom: 0.9rem;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 10px;
      overflow: hidden;
      box-shadow: var(--shadow-sm);
    }
    .phrases-list.hidden { display: none; }
    .phrases-list-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      padding: 0.6rem 0.95rem;
      background: var(--bg-elevated);
      border-bottom: 1px solid var(--border);
    }
    .phrases-list-title {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--text-strong);
    }
    .phrases-list-count {
      font-size: 0.7rem;
      color: var(--text-subtle);
      font-variant-numeric: tabular-nums;
    }
    #phrases-list-body { max-height: 460px; overflow-y: auto; }

    /* Note: phrase-row* styles live in the is:global block below — those rows
       are created in JS and don't get Astro's scope hash. */

    .defaults-banner {
      display: flex;
      align-items: center;
      gap: 0.7rem;
      flex-wrap: wrap;
      padding: 0.6rem 0.9rem;
      margin-bottom: 1.2rem;
      background: var(--accent-soft);
      border: 1px solid var(--accent);
      border-radius: 10px;
      font-size: 0.82rem;
      color: var(--text);
    }
    .defaults-banner.hidden { display: none; }
    .banner-icon { font-size: 1rem; }
    .banner-text { flex: 1; }
    .banner-actions {
      display: inline-flex;
      gap: 0.4rem;
      flex-wrap: wrap;
    }
    .star-active {
      background: var(--accent) !important;
      border-color: var(--accent) !important;
      color: white !important;
    }
    .default-tag {
      display: inline-block;
      margin-left: 0.5rem;
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--accent);
      vertical-align: middle;
    }

    .reference-tabs {
      display: flex;
      gap: 0.35rem;
      padding: 0.25rem;
      margin-bottom: 0.75rem;
      background: var(--bg-input);
      border: 1px solid var(--border);
      border-radius: 10px;
    }
    .reference-tab {
      flex: 1;
      padding: 0.48rem 0.7rem;
      background: transparent;
      border: 0;
      border-radius: 7px;
      color: var(--text-muted);
      font-size: 0.78rem;
      font-weight: 700;
      cursor: pointer;
